<div class="toast-container position-fixed top-0 end-0 p-3">
    @foreach (ToastInfos toast in toasts)
    {
        <Toast Message="@toast.Message"
               Severity="@toast.Severity"
               OnHidden="@(() => toasts.RemoveAll((t) => t.Id == toast.Id))"
               @key="toast.Id" />
    }
</div>
