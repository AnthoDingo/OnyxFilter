@using OnyxFilter.Services.Encryption

<dl class="cert-details">
    <div class="cert-row">
        <dt>@L["Noms"]</dt>
        <dd class="mono">@Certificate.DisplayName</dd>
    </div>
    <div class="cert-row">
        <dt>@L["Émis par"]</dt>
        <dd>@(string.IsNullOrEmpty(Certificate.Issuer) ? "—" : Certificate.Issuer)</dd>
    </div>
    <div class="cert-row">
        <dt>@L["Valide"]</dt>
        <dd>
            @L["du {0} au {1}", FormatDay(Certificate.NotBeforeUtc), FormatDay(Certificate.NotAfterUtc)]
            <span class="cert-remaining @RemainingTone">(@RemainingText)</span>
        </dd>
    </div>
</dl>

@if (MissingServerName)
{
    <div class="alert alert-warning mt-3 mb-0">
        @L["Le nom du serveur"] <span class="mono">@ServerName</span> @L["ne figure pas dans ce certificat : les appareils refuseront la connexion chiffrée."]
    </div>
}
