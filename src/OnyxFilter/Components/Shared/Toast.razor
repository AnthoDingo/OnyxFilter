<div class="toast-container position-fixed top-0 end-0 p-3">
    <div
        class="toast @(Message.StartsWith(L["Erreur"], StringComparison.Ordinal) ? "text-bg-danger" : "text-bg-success")"
        role="alert"
        aria-live="assertive"
        aria-atomic="true"
        @ref="ToastRef"
    >
        <div class="toast-body">
            @Message
        </div>
    </div>
</div>
