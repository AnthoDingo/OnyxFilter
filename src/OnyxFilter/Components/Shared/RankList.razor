@if (Items.Count == 0)
{
    <p class="rank-empty">@EmptyText</p>
}
else
{
    <ol class="rank-list rank-tone-@Tone.ToString().ToLowerInvariant()">
        @for (int index = 0; index < Items.Count; index++)
        {
            RankItem item = Items[index];
            <li class="rank-row" style="--share: @ShareOf(item)">
                <span class="rank-position">@(index + 1)</span>
                <span class="rank-label" title="@(item.Location is null ? item.Label : $"{item.Label} — {item.Location.CountryCode} AS{item.Location.Asn} {item.Location.Description}")">
                    @if (item.Location is not null)
                    {
                        <span class="client-flag" aria-label="@item.Location.CountryCode">@item.Location.Flag</span>
                    }
                    @item.Label
                    @if (item.Location is not null)
                    {
                        <span class="rank-detail">@item.Location.Provider</span>
                    }
                </span>
                <span class="rank-count">@FormatCount(item.Count)</span>
            </li>
        }
    </ol>
}
