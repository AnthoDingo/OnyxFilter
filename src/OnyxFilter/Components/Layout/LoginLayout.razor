@inherits LayoutComponentBase

<div class="auth-shell">
    <aside class="auth-brand" aria-hidden="true">
        <div class="auth-brand-top">
            <BrandMark />
            <span class="auth-brand-name">Onyx<strong>Filter</strong></span>
        </div>

        <div class="auth-brand-body">
            <p class="auth-brand-kicker">Résolveur DNS filtrant</p>
            <p class="auth-brand-title">Votre réseau, vos règles.</p>
            <ul class="auth-brand-points">
                <li>Blocage des publicités et des traqueurs pour tous les appareils</li>
                <li>Journal et statistiques gardés chez vous</li>
                <li>DNS chiffré : HTTPS, TLS et QUIC</li>
            </ul>
        </div>

        <p class="auth-brand-foot">Auto-hébergé · open source</p>
    </aside>

    <main class="auth-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span>Une erreur inattendue est survenue.</span>
    <a href="." class="reload">Recharger la page</a>
    <button type="button" class="dismiss" aria-label="Masquer"><Icon Name="close" /></button>
</div>
