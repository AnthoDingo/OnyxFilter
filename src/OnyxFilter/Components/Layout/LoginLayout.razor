@inherits LayoutComponentBase

<div class="auth-shell">
    <aside class="auth-brand" aria-hidden="true">
        <div class="auth-brand-top">
            <BrandMark />
            <span class="auth-brand-name">Onyx<strong>Filter</strong></span>
        </div>

        <div class="auth-brand-body">
            <p class="auth-brand-kicker">@L["Résolveur DNS filtrant"]</p>
            <p class="auth-brand-title">@L["Votre réseau, vos règles."]</p>
            <ul class="auth-brand-points">
                <li>@L["Blocage des publicités et des traqueurs pour tous les appareils"]</li>
                <li>@L["Journal et statistiques gardés chez vous"]</li>
                <li>@L["DNS chiffré : HTTPS, TLS et QUIC"]</li>
            </ul>
        </div>

        <p class="auth-brand-foot">@L["Auto-hébergé · open source"]</p>
    </aside>

    <main class="auth-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span>@L["Une erreur inattendue est survenue."]</span>
    <a href="." class="reload">@L["Recharger la page"]</a>
    <button type="button" class="dismiss" aria-label="@L["Masquer"]"><Icon Name="close" /></button>
</div>
