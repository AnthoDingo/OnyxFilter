@inherits LayoutComponentBase

<div class="shell" data-shell>
    <NavMenu />

    <div class="shell-scrim" data-nav-close aria-hidden="true"></div>

    <div class="shell-main">
        <header class="shell-topbar">
            <button type="button" class="shell-burger" data-nav-toggle aria-controls="app-sidebar" aria-expanded="false" aria-label="Ouvrir le menu">
                <Icon Name="menu" />
            </button>
            <a href="" class="shell-topbar-brand">
                <BrandMark />
                <span>Onyx<strong>Filter</strong></span>
            </a>
        </header>

        <main class="shell-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <Icon Name="alert" />
    <span>Une erreur inattendue est survenue.</span>
    <a href="." class="reload">Recharger la page</a>
    <button type="button" class="dismiss" aria-label="Masquer"><Icon Name="close" /></button>
</div>
