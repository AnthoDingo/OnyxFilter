@if (IsVisible)
{
    <a href="settings/updates" class="update-notice @(IsInProgress ? "is-progress" : "")">
        <Icon Name="download" />
        <span class="update-notice-text">
            @if (IsInProgress)
            {
                <span>@L["Mise à jour en cours…"]</span>
            }
            else
            {
                <span>@L["Version {0} disponible", LatestVersion]</span>
            }
        </span>
    </a>
}
