@page "/account/passkeys"
@attribute [Authorize]

<PageTitle>Clés d'accès · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">Compte</p>
        <h1 class="page-title">Clés d'accès</h1>
        <p class="page-lead">Connexion sans mot de passe via l'empreinte, le visage ou une clé de sécurité.</p>
    </div>
</header>

<StatusMessage Message="@Message" />

<div class="card table-panel" style="max-width: 48rem;">
    @if (CurrentPasskeys is { Count: > 0 })
    {
        <table class="table align-middle">
            <tbody>
                @foreach (UserPasskeyInfo passkey in CurrentPasskeys)
                {
                    <tr>
                        <td>
                            <span class="list-name">@(passkey.Name ?? "Clé d'accès")</span>
                            <span class="text-body-secondary small">Ajoutée le @FormatCreatedAt(passkey.CreatedAt)</span>
                        </td>
                        <td>
                            @{
                                string credentialId = EncodeCredentialId(passkey.CredentialId);
                            }
                            <form class="row-actions" @formname="@($"delete-passkey-{credentialId}")" @onsubmit="DeletePasskeyAsync" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="CredentialId" value="@credentialId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="empty-state mb-0">
            <span class="empty-state-title">Aucune clé d'accès</span>
            Ajoutez-en une pour vous connecter sans mot de passe.
        </p>
    }

    <form class="settings-panel-footer" @formname="add-passkey" @onsubmit="AddPasskeyAsync" method="post">
        <AntiforgeryToken />
        @if (CurrentPasskeys is { Count: >= MaxPasskeyCount })
        {
            <p class="text-danger mb-0">Nombre maximal de clés atteint : supprimez-en une avant d'en ajouter une autre.</p>
        }
        else
        {
            <PasskeySubmit Operation="PasskeyOperation.Create" Name="Input" class="btn btn-secondary">
                <Icon Name="plus" />Ajouter une clé d'accès
            </PasskeySubmit>
        }
    </form>
</div>
