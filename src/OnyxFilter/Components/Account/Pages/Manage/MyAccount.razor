@page "/account/my-account"
@attribute [Authorize]

<PageTitle>@L["Mon compte"] · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">@L["Compte"]</p>
        <h1 class="page-title">@L["Mon compte"]</h1>
        <p class="page-lead">@L["Identifiants de connexion à la console d'administration."]</p>
    </div>
</header>

<StatusMessage Message="@Message" />

<div class="settings-sections">

    <section class="settings-section">
        <div class="settings-intro">
            <h2 class="settings-intro-title">@L["Identifiant"]</h2>
            <p class="settings-intro-text">@L["Nom utilisé pour vous connecter."]</p>
        </div>

        <form class="card settings-panel" @formname="change-username" @onsubmit="ChangeUsernameAsync" method="post">
            <AntiforgeryToken />
            <div class="setting setting-stacked">
                <div class="setting-text">
                    <label class="setting-label" for="new-username">@L["Nouveau nom d'utilisateur"]</label>
                    <p class="setting-help">@L["Actuellement :"] <strong class="mono">@CurrentUsername</strong></p>
                </div>
                <div class="setting-nested field-narrow">
                    <input id="new-username"
                           type="text"
                           class="form-control"
                           name="UsernameInput.NewUsername"
                           value="@UsernameInput.NewUsername"
                           required
                           autocomplete="username" />
                </div>
            </div>
            <div class="settings-panel-footer">
                <button type="submit" class="btn btn-primary">@L["Enregistrer"]</button>
            </div>
        </form>
    </section>

    <section class="settings-section">
        <div class="settings-intro">
            <h2 class="settings-intro-title">@L["Mot de passe"]</h2>
            <p class="settings-intro-text">@L["Choisissez une phrase longue et unique."]</p>
        </div>

        <form class="card settings-panel" @formname="change-password" @onsubmit="ChangePasswordAsync" method="post">
            <AntiforgeryToken />
            <div class="setting setting-stacked">
                <div class="field-grid">
                    <div>
                        <label class="form-label" for="current-password">@L["Mot de passe actuel"]</label>
                        <input id="current-password"
                               type="password"
                               class="form-control"
                               name="PasswordInput.CurrentPassword"
                               required
                               autocomplete="current-password" />
                    </div>
                </div>
                <div class="field-grid mt-3">
                    <div>
                        <label class="form-label" for="new-password">@L["Nouveau mot de passe"]</label>
                        <input id="new-password"
                               type="password"
                               class="form-control"
                               name="PasswordInput.NewPassword"
                               required
                               autocomplete="new-password" />
                    </div>
                    <div>
                        <label class="form-label" for="confirm-password">@L["Confirmation"]</label>
                        <input id="confirm-password"
                               type="password"
                               class="form-control"
                               name="PasswordInput.ConfirmNewPassword"
                               required
                               autocomplete="new-password" />
                    </div>
                </div>
            </div>
            <div class="settings-panel-footer">
                <button type="submit" class="btn btn-primary">@L["Changer le mot de passe"]</button>
            </div>
        </form>
    </section>

    <section class="settings-section">
        <div class="settings-intro">
            <h2 class="settings-intro-title">@L["Clés d'accès"]</h2>
            <p class="settings-intro-text">@L["Connexion sans mot de passe via l'empreinte, le visage ou une clé de sécurité."]</p>
        </div>

        <div class="card settings-panel">
            @if (CurrentPasskeys is { Count: > 0 })
            {
                <ul class="passkey-list">
                    @foreach (UserPasskeyInfo passkey in CurrentPasskeys)
                    {
                        string credentialId = EncodeCredentialId(passkey.CredentialId);
                        <li class="passkey-item">
                            <span class="passkey-icon" aria-hidden="true"><Icon Name="key" /></span>
                            <span class="passkey-text">
                                <span class="passkey-name">@L[passkey.Name ?? "Clé d'accès"]</span>
                                <span class="passkey-date">@L["Ajoutée le {0}", FormatCreatedAt(passkey.CreatedAt)]</span>
                            </span>
                            <form @formname="@($"delete-passkey-{credentialId}")" @onsubmit="DeletePasskeyAsync" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="CredentialId" value="@credentialId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["Supprimer"]</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="empty-state mb-0">
                    <span class="empty-state-title">@L["Aucune clé d'accès"]</span>
                    @L["Ajoutez-en une pour vous connecter sans mot de passe."]
                </p>
            }

            <form class="settings-panel-footer" @formname="add-passkey" @onsubmit="AddPasskeyAsync" method="post">
                <AntiforgeryToken />
                @if (CurrentPasskeys is { Count: >= MaxPasskeyCount })
                {
                    <p class="text-danger mb-0">@L["Nombre maximal de clés atteint : supprimez-en une avant d'en ajouter une autre."]</p>
                }
                else
                {
                    <PasskeySubmit Operation="PasskeyOperation.Create" Name="PasskeyInput" class="btn btn-secondary">
                        <Icon Name="plus" />@L["Ajouter une clé d'accès"]
                    </PasskeySubmit>
                }
            </form>
        </div>
    </section>

</div>
