@page "/query-log"
@attribute [Authorize]
@rendermode InteractiveServer
@using OnyxFilter.Services.QueryLog

<PageTitle>Journal des requêtes · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">Supervision</p>
        <h1 class="page-title">Journal des requêtes</h1>
        <p class="page-lead">Chaque requête DNS traitée, avec la décision prise et le client à l'origine.</p>
    </div>
    <div class="page-actions">
        <div class="form-check form-switch live-switch mb-0" title="Actualise le journal toutes les 5 secondes">
            <input class="form-check-input" type="checkbox" role="switch" id="auto-refresh-switch" checked="@AutoRefreshEnabled" @onchange="OnAutoRefreshToggled" />
            <label class="form-check-label" for="auto-refresh-switch">Direct</label>
        </div>
        <button type="button" class="btn btn-secondary" @onclick="RefreshAsync" disabled="@IsLoading">
            <Icon Name="refresh" />Actualiser
        </button>
    </div>
</header>

@if (!IsLogEnabled)
{
    <div class="alert alert-warning page-status">
        L'enregistrement des requêtes est désactivé. Activez-le dans <a href="/settings/general">Général</a>.
    </div>
}

@if (FallbackFilePath is not null)
{
    <div class="alert alert-danger page-status">
        Base de données inaccessible : les nouvelles requêtes sont écrites dans un fichier de secours
        (<code>@FallbackFilePath</code>) et n'apparaissent pas ci-dessous tant que la base n'est pas rétablie. La
        résolution DNS n'est pas affectée.
    </div>
}
else if (!IsDatabaseHealthy)
{
    <div class="alert alert-warning page-status">
        Base de données temporairement inaccessible, nouvelle tentative en cours : les requêtes récentes peuvent
        manquer ci-dessous.
    </div>
}

<div class="card table-panel">
    <div class="log-toolbar">
        <div class="log-search">
            <Icon Name="search" />
            <input type="search" class="form-control" placeholder="Filtrer par domaine ou client" aria-label="Filtrer par domaine ou client" value="@SearchText" @oninput="OnSearchChanged" />
        </div>

        <select class="form-select log-filter" aria-label="Filtrer par décision" @onchange="OnStatusFilterChanged">
            <option value="">Toutes les décisions</option>
            <option value="Resolved">Résolues</option>
            <option value="Cached">Servies depuis le cache</option>
            <option value="Rewritten">Réécrites</option>
            <option value="SafeSearch">Recherche sécurisée</option>
            <option value="CustomRule">Règle personnalisée</option>
            <option value="Filtered">Bloquées par une liste</option>
            <option value="BlockedService">Service bloqué</option>
            <option value="SecurityThreat">Menace</option>
            <option value="ParentalControl">Contrôle parental</option>
        </select>

        <div class="segmented log-density" role="radiogroup" aria-label="Densité d'affichage">
            <input class="btn-check" type="radio" name="log-density" id="log-density-compact" checked="@IsCompact" @onchange="() => IsCompact = true" />
            <label class="segmented-option" for="log-density-compact">Compacte</label>
            <input class="btn-check" type="radio" name="log-density" id="log-density-detailed" checked="@(!IsCompact)" @onchange="() => IsCompact = false" />
            <label class="segmented-option" for="log-density-detailed">Détaillée</label>
        </div>
    </div>

    @if (IsLoading)
    {
        <p class="empty-state mb-0">Chargement…</p>
    }
    else if (Entries.Count == 0)
    {
        <p class="empty-state mb-0">
            <span class="empty-state-title">Aucune requête</span>
            Rien à afficher pour ces critères.
        </p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle log-table @(IsCompact ? "is-compact" : "")">
                <thead>
                    <tr>
                        <th scope="col" class="col-time">Heure</th>
                        <th scope="col">Requête</th>
                        <th scope="col" class="col-status">Décision</th>
                        <th scope="col" class="col-client">Client</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DnsQueryLogRecord entry in Entries)
                    {
                        <tr class="@GetRowClass(entry.Reason)">
                            <td class="col-time">
                                <span class="log-time">@entry.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                                <span class="log-secondary">@entry.TimestampUtc.ToLocalTime().ToString("dd/MM/yyyy")</span>
                            </td>
                            <td>
                                <span class="log-domain">@entry.Domain</span>
                                <span class="log-type">@entry.QueryType</span>
                            </td>
                            <td class="col-status">
                                @switch (entry.Reason)
                                {
                                    case QueryLogReason.Filtered:
                                        <span class="log-status log-status-blocked">Liste de blocage</span>
                                        break;
                                    case QueryLogReason.CustomRule:
                                        <span class="log-status log-status-blocked">Règle perso.</span>
                                        break;
                                    case QueryLogReason.BlockedService:
                                        <span class="log-status log-status-blocked">Service bloqué</span>
                                        break;
                                    case QueryLogReason.SecurityThreat:
                                        <span class="log-status log-status-warn">Menace</span>
                                        break;
                                    case QueryLogReason.ParentalControl:
                                        <span class="log-status log-status-warn">Contrôle parental</span>
                                        break;
                                    case QueryLogReason.Rewritten:
                                        <span class="log-status log-status-info">Réécrite</span>
                                        break;
                                    case QueryLogReason.SafeSearch:
                                        <span class="log-status log-status-info">Recherche sécurisée</span>
                                        break;
                                    case QueryLogReason.Cached:
                                        <span class="log-status log-status-muted">Cache</span>
                                        break;
                                    default:
                                        <span class="log-status log-status-ok">Résolue</span>
                                        break;
                                }
                                <span class="log-secondary">
                                    @if (!string.IsNullOrEmpty(entry.ReasonDetail))
                                    {
                                        <span class="log-reason" title="@entry.ReasonDetail">@entry.ReasonDetail</span>
                                    }
                                    <span class="log-ms">@entry.ProcessingTimeMs ms</span>
                                </span>
                            </td>
                            <td class="col-client log-client">@entry.ClientKey</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-bar">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPageIndex <= 0 || IsLoading)" @onclick="GoToPreviousPageAsync">Plus récentes</button>

            <div class="pagination-bar-center">
                <span>@DisplayedRangeText</span>
                <select class="form-select form-select-sm" aria-label="Lignes par page" value="@PageSize" @onchange="OnPageSizeChanged" disabled="@IsLoading">
                    @foreach (int option in PageSizeOptions)
                    {
                        <option value="@option">@option par page</option>
                    }
                </select>
            </div>

            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!HasNextPage || IsLoading)" @onclick="GoToNextPageAsync">Plus anciennes</button>
        </div>
    }
</div>

<p class="page-note">
    Ce qui est enregistré et la durée de conservation se règlent dans <a href="/settings/general">Général</a>.
</p>
