@page "/login"
@attribute [AllowAnonymous]
@layout LoginLayout

<PageTitle>Connexion - OnyxFilter</PageTitle>

<div class="card bg-dark border-secondary shadow" style="width: 100%; max-width: 380px;">
    <div class="card-body p-4">

        <div class="text-center mb-4">
            <svg width="52" height="52" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M24 4L6 11v13c0 10.5 7.7 20.3 18 22.9C35.3 44.3 42 34.5 42 24V11L24 4z" fill="#22c55e" fill-opacity="0.15" stroke="#22c55e" stroke-width="2" stroke-linejoin="round"/>
                <path d="M16 24l5.5 5.5L32 19" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div class="text-uppercase fw-bold mt-2" style="letter-spacing: 0.08em;">OnyxFilter</div>
            <div class="text-muted small text-uppercase" style="letter-spacing: 0.12em; font-size: 0.7rem;">DNS Filter</div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger py-2 small" role="alert">@ErrorMessage</div>
        }

        <EditForm EditContext="CurrentEditContext" method="post" OnSubmit="LoginUserAsync" FormName="login">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label small fw-medium" for="username">Nom d'utilisateur</label>
                <InputText id="username" class="form-control form-control-sm bg-dark-subtle border-secondary text-light"
                           @bind-Value="Input.Username"
                           autocomplete="username webauthn" aria-required="true"
                           placeholder="Saisir un nom d'utilisateur" />
                <ValidationMessage For="() => Input.Username" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-medium" for="password">Mot de passe</label>
                <InputText type="password" id="password" class="form-control form-control-sm bg-dark-subtle border-secondary text-light"
                           @bind-Value="Input.Password"
                           autocomplete="current-password" aria-required="true"
                           placeholder="Saisir un mot de passe" />
                <ValidationMessage For="() => Input.Password" class="text-danger small" />
            </div>

            <button type="submit" class="btn btn-success w-100 mb-3">Connexion</button>

            <div class="text-center">
                <PasskeySubmit Operation="PasskeyOperation.Request" Name="Input.Passkey" EmailName="Input.Username"
                               class="btn btn-link btn-sm text-muted p-0">
                    Se connecter avec une clé d'accès
                </PasskeySubmit>
            </div>
        </EditForm>

    </div>
</div>
