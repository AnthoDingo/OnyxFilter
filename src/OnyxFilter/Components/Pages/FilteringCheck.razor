@page "/filters/check"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Tester un domaine · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">Filtrage</p>
        <h1 class="page-title">Tester un domaine</h1>
        <p class="page-lead">Simulez une requête pour savoir si un domaine serait bloqué, autorisé ou réécrit, et pourquoi.</p>
    </div>
</header>

<div class="card check-card">
    <div class="card-body">
        <div class="check-search">
            <Icon Name="search" />
            <input id="check-host" type="text" class="form-control check-host" placeholder="exemple.fr" aria-label="Nom d'hôte ou domaine à tester" @bind="HostName" @bind:event="oninput" />
            <button type="button" class="btn btn-primary" @onclick="CheckAsync" disabled="@IsChecking">
                @(IsChecking ? "Vérification…" : "Tester")
            </button>
        </div>

        <div class="field-grid mt-3">
            <div>
                <label class="form-label" for="check-client">Client simulé <span class="text-body-secondary fw-normal">(facultatif)</span></label>
                <input id="check-client" type="text" class="form-control font-monospace" placeholder="192.168.1.42 ou identifiant" @bind="ClientIdentifier" @bind:event="oninput" />
            </div>
            <div>
                <label class="form-label" for="check-record-type">Type d'enregistrement</label>
                <select id="check-record-type" class="form-select" value="@SelectedRecordType" @onchange="OnRecordTypeChanged">
                    @foreach ((string Label, ushort Type) option in RecordTypeOptions)
                    {
                        <option value="@option.Type">@option.Label</option>
                    }
                </select>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-3 mb-0">@ErrorMessage</div>
        }
    </div>

    @if (!string.IsNullOrEmpty(ResultMessage))
    {
        <div class="check-result">
            <p class="check-result-label">Résultat</p>
            <div class="alert @ResultCssClass mb-0">@ResultMessage</div>
        </div>
    }
</div>
