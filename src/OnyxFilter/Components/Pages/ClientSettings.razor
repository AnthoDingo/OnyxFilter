@page "/settings/client"
@attribute [Authorize]
@rendermode InteractiveServer
@using OnyxFilter.Services.Statistics

<PageTitle>Paramètres du client - OnyxFilter</PageTitle>

<h1 class="page-title">Paramètres du client</h1>

<div class="settings-page">
    <div class="row justify-content-center">
        <div class="col-md-10 col-12">
            <div class="card mb-4 table-card-split">
                <div class="card-body">
                    <h2 class="card-title fs-5">Clients persistants</h2>
                    <p class="text-body-secondary">
                        Configurez des réglages propres à certains appareils (identifiés par adresse IP ou plage CIDR) : sécurité de
                        navigation, contrôle parental, recherche sécurisée, services bloqués et serveurs en amont personnalisés.
                    </p>

                    <div class="table-responsive mb-3">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Client</th>
                                    <th>Nom</th>
                                    <th>Paramètres</th>
                                    <th>Services bloqués</th>
                                    <th>En amont</th>
                                    <th>Mots clés</th>
                                    <th>Nombre de requêtes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Clients.Count == 0)
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-body-secondary py-4">Aucun client trouvé</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (PersistentClientEntry entry in PagedClients)
                                    {
                                        <tr>
                                            <td class="client-cell" title="@string.Join(", ", entry.Identifiers)">@string.Join(", ", entry.Identifiers)</td>
                                            <td>@entry.Name</td>
                                            <td>
                                                @if (entry.UseGlobalSettings)
                                                {
                                                    <span class="badge text-bg-secondary">Paramètres globaux</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-primary">Personnalisé</span>
                                                }
                                            </td>
                                            <td>
                                                @if (entry.UseGlobalBlockedServices)
                                                {
                                                    <span>Global</span>
                                                }
                                                else
                                                {
                                                    <span>@(entry.BlockedServiceIds.Count) service(s)</span>
                                                }
                                            </td>
                                            <td>
                                                @if (entry.UpstreamServers.Count == 0)
                                                {
                                                    <span>Global</span>
                                                }
                                                else
                                                {
                                                    <span>@(entry.UpstreamServers.Count) serveur(s)</span>
                                                }
                                            </td>
                                            <td>@string.Join(", ", entry.Tags)</td>
                                            <td>@GetQueryCount(entry).ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                                            <td>
                                                <div class="filter-list-actions">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" title="Modifier" @onclick="() => OpenEditDialog(entry)">
                                                        <icon class="filter-list-icon icon-edit" aria-hidden="true"></icon>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Supprimer" @onclick="() => RequestDelete(entry)">
                                                        <icon class="filter-list-icon icon-trash" aria-hidden="true"></icon>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination-bar mb-3">
                        <button type="button" class="btn btn-outline-secondary" disabled="@(CurrentPage <= 1)" @onclick="GoToPreviousPage">Précédent</button>

                        <div class="pagination-bar-center">
                            <span>Page @CurrentPage / @TotalPages</span>

                            <select class="form-select form-select-sm" style="width:auto;" value="@PageSize" @onchange="OnPageSizeChanged">
                                @foreach (int option in PageSizeOptions)
                                {
                                    <option value="@option">@option lignes</option>
                                }
                            </select>
                        </div>

                        <button type="button" class="btn btn-outline-secondary" disabled="@(CurrentPage >= TotalPages)" @onclick="GoToNextPage">Suivant</button>
                    </div>

                    <button type="button" class="btn btn-success" @onclick="OpenAddDialog">Ajouter un client</button>

                    @if (!string.IsNullOrEmpty(StatusMessage))
                    {
                        <div class="alert @(StatusMessage.StartsWith("Erreur", StringComparison.Ordinal) ? "alert-danger" : "alert-success") py-2 mt-3 mb-0">@StatusMessage</div>
                    }
                </div>
            </div>

            <div class="card mb-4 table-card-split">
                <div class="card-body">
                    <h2 class="card-title fs-5">Clients d'exécution</h2>
                    <p class="text-body-secondary">
                        Adresses IP observées dans les statistiques de résolution DNS, qui ne correspondent à aucun client
                        persistant configuré ci-dessus.
                    </p>

                    <div class="table-responsive mb-3">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Client</th>
                                    <th>Nom</th>
                                    <th>Source</th>
                                    <th>WHOIS</th>
                                    <th>Nombre de requêtes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (RuntimeClients.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-body-secondary py-4">Aucun client trouvé</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (DnsStatisticsEntry entry in PagedRuntimeClients)
                                    {
                                        <tr>
                                            <td>@entry.Label</td>
                                            <td>—</td>
                                            <td>Statistiques</td>
                                            <td>—</td>
                                            <td>@entry.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination-bar">
                        <button type="button" class="btn btn-outline-secondary" disabled="@(RuntimeCurrentPage <= 1)" @onclick="GoToPreviousRuntimePage">Précédent</button>

                        <div class="pagination-bar-center">
                            <span>Page @RuntimeCurrentPage / @RuntimeTotalPages</span>

                            <select class="form-select form-select-sm" style="width:auto;" value="@RuntimePageSize" @onchange="OnRuntimePageSizeChanged">
                                @foreach (int option in PageSizeOptions)
                                {
                                    <option value="@option">@option lignes</option>
                                }
                            </select>
                        </div>

                        <button type="button" class="btn btn-outline-secondary" disabled="@(RuntimeCurrentPage >= RuntimeTotalPages)" @onclick="GoToNextRuntimePage">Suivant</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowDialog)
{
    <div class="modal-backdrop-static" @onclick="CloseDialog"></div>

    <div class="modal-static">
        <div class="card" style="width: 40rem; max-width: 92vw;">
            <div class="card-body">
                <h2 class="card-title fs-5">@(IsEditMode ? "Modifier le client" : "Ajouter un client")</h2>

                <div class="mb-3">
                    <label class="form-label" for="dialog-client-name">Nom</label>
                    <input id="dialog-client-name" type="text" class="form-control" @bind="DialogName" @bind:event="oninput" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="dialog-client-identifiers">Identifiants (adresses IP ou plages CIDR, une par ligne)</label>
                    <textarea id="dialog-client-identifiers" class="form-control font-monospace" rows="3" placeholder="192.168.1.42&#10;192.168.1.0/24" @bind="DialogIdentifiersText" @bind:event="oninput"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="dialog-client-tags">Mots clés (un par ligne)</label>
                    <textarea id="dialog-client-tags" class="form-control" rows="2" @bind="DialogTagsText" @bind:event="oninput"></textarea>
                </div>

                <hr />

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="dialog-use-global-settings" checked="@DialogUseGlobalSettings" @onchange="e => DialogUseGlobalSettings = e.Value is bool v && v" />
                    <label class="form-check-label" for="dialog-use-global-settings">Utiliser les paramètres globaux</label>
                </div>

                @if (!DialogUseGlobalSettings)
                {
                    <div class="ms-4 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="dialog-filtering" checked="@DialogFilteringEnabled" @onchange="e => DialogFilteringEnabled = e.Value is bool v && v" />
                            <label class="form-check-label" for="dialog-filtering">Bloquer les domaines à l'aide des filtres</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="dialog-browsing-security" checked="@DialogBrowsingSecurityEnabled" @onchange="e => DialogBrowsingSecurityEnabled = e.Value is bool v && v" />
                            <label class="form-check-label" for="dialog-browsing-security">Sécurité de navigation</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="dialog-parental-control" checked="@DialogParentalControlEnabled" @onchange="e => DialogParentalControlEnabled = e.Value is bool v && v" />
                            <label class="form-check-label" for="dialog-parental-control">Contrôle parental</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="dialog-safe-search" checked="@DialogSafeSearchEnabled" @onchange="e => DialogSafeSearchEnabled = e.Value is bool v && v" />
                            <label class="form-check-label" for="dialog-safe-search">Recherche Sécurisée</label>
                        </div>
                    </div>
                }

                <hr />

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="dialog-use-global-blocked-services" checked="@DialogUseGlobalBlockedServices" @onchange="e => DialogUseGlobalBlockedServices = e.Value is bool v && v" />
                    <label class="form-check-label" for="dialog-use-global-blocked-services">Utiliser les services bloqués globaux</label>
                </div>

                @if (!DialogUseGlobalBlockedServices)
                {
                    <div class="ms-4 mb-3 client-service-grid">
                        @foreach (KnownBlockedService.Entry service in KnownBlockedService.All)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@("dialog-service-" + service.Id)" checked="@DialogBlockedServiceIds.Contains(service.Id)" @onchange="e => ToggleBlockedService(service.Id, e)" />
                                <label class="form-check-label" for="@("dialog-service-" + service.Id)">@service.DisplayName</label>
                            </div>
                        }
                    </div>
                }

                <hr />

                <div class="mb-3">
                    <label class="form-label" for="dialog-client-upstreams">Serveurs DNS en amont (un par ligne, vide = serveurs globaux)</label>
                    <textarea id="dialog-client-upstreams" class="form-control font-monospace" rows="2" @bind="DialogUpstreamServersText" @bind:event="oninput"></textarea>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="dialog-ignore-query-log" checked="@DialogIgnoreQueryLog" @onchange="e => DialogIgnoreQueryLog = e.Value is bool v && v" />
                    <label class="form-check-label" for="dialog-ignore-query-log">Ne pas enregistrer dans le journal des requêtes</label>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="dialog-ignore-statistics" checked="@DialogIgnoreStatistics" @onchange="e => DialogIgnoreStatistics = e.Value is bool v && v" />
                    <label class="form-check-label" for="dialog-ignore-statistics">Ne pas compter dans les statistiques</label>
                </div>

                @if (!string.IsNullOrEmpty(DialogError))
                {
                    <div class="alert alert-danger py-2 mb-0 mt-3">@DialogError</div>
                }
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-success" @onclick="SaveDialogAsync" disabled="@IsSavingDialog">
                        @(IsSavingDialog ? "Enregistrement..." : "Enregistrer")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDialog" disabled="@IsSavingDialog">Annuler</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm && EntryPendingDeletion is not null)
{
    <div class="modal-backdrop-static" @onclick="CancelDelete"></div>

    <div class="modal-static">
        <div class="card" style="width: 28rem; max-width: 90vw;">
            <div class="card-body">
                <h2 class="card-title fs-5">Supprimer le client</h2>
                <p class="mb-0">
                    Voulez-vous vraiment supprimer « @EntryPendingDeletion.Name » ? Cette action ne peut pas être annulée.
                </p>
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync">Supprimer</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">Annuler</button>
                </div>
            </div>
        </div>
    </div>
}
