@page "/not-found"
@layout MainLayout
@attribute [AllowAnonymous]

<PageTitle>@L["Page introuvable"] · OnyxFilter</PageTitle>

<div class="card placeholder-card">
    <span class="placeholder-code mono" aria-hidden="true">404</span>
    <h1 class="placeholder-title">@L["Page introuvable"]</h1>
    <p class="placeholder-text">@L["L'adresse demandée ne correspond à aucune page de la console."]</p>
    <a href="" class="btn btn-primary">@L["Retour à la vue d'ensemble"]</a>
</div>
