@page "/settings/encryption"
@attribute [Authorize]
@rendermode InteractiveServer
@using OnyxFilter.Services.Encryption

<PageTitle>@L["Chiffrement"] · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">@L["Configuration"]</p>
        <h1 class="page-title">@L["Chiffrement"]</h1>
        <p class="page-lead">@L["HTTPS pour l'interface d'administration, DNS-over-HTTPS, DNS-over-TLS et DNS-over-QUIC pour les appareils."]</p>
    </div>
</header>

<div class="settings-sections">

    <section class="settings-section">
        <div class="settings-intro">
            <h2 class="settings-intro-title">@L["Protocoles"]</h2>
            <p class="settings-intro-text">
                @L["Activez le chiffrement puis fournissez un certificat valide pour le nom du serveur, ou laissez Let's Encrypt s'en charger (section suivante)."]
            </p>
        </div>

        <div class="card settings-panel">
            <div class="setting">
                <div class="setting-text">
                    <label class="setting-label" for="enable-encryption">@L["Activer le chiffrement"]</label>
                    <p class="setting-help">
                        @L["Dès qu'un certificat valide est en place, l'interface est aussi servie en HTTPS et le serveur DNS accepte les requêtes en DNS-over-HTTPS, DNS-over-TLS et DNS-over-QUIC."]
                    </p>
                </div>
                <div class="form-check form-switch setting-control">
                    <input class="form-check-input" type="checkbox" role="switch" id="enable-encryption" checked="@EnableEncryption" @onchange="OnEnableEncryptionChanged" />
                </div>
            </div>

            <div class="setting">
                <div class="setting-text">
                    <label class="setting-label" for="enable-plain-dns">@L["Accepter le DNS non chiffré"]</label>
                    <p class="setting-help">
                        @L["Désactivez-le pour imposer un protocole chiffré à tous les appareils (au moins un protocole chiffré doit alors être actif)."]
                    </p>
                </div>
                <div class="form-check form-switch setting-control">
                    <input class="form-check-input" type="checkbox" role="switch" id="enable-plain-dns" checked="@EnablePlainDns" @onchange="OnEnablePlainDnsChanged" />
                </div>
            </div>

            <div class="setting">
                <div class="setting-text">
                    <label class="setting-label" for="auto-redirect-https">@L["Rediriger HTTP vers HTTPS"]</label>
                    <p class="setting-help">
                        @L["Une fois HTTPS actif, les visites en HTTP sont renvoyées vers HTTPS et le navigateur retient de n'utiliser que HTTPS pour ce nom (HSTS, 30 jours)."]
                    </p>
                </div>
                <div class="form-check form-switch setting-control">
                    <input class="form-check-input" type="checkbox" role="switch" id="auto-redirect-https" checked="@AutoRedirectToHttps" @onchange="OnAutoRedirectToHttpsChanged" />
                </div>
            </div>

            <div class="setting setting-stacked">
                <div class="setting-text">
                    <label class="setting-label" for="server-name">@L["Nom du serveur"]</label>
                    <p class="setting-help">
                        @L["Doit figurer parmi les noms du certificat. Renseigné, il active la détection des identifiants de client, les réponses DDR et des contrôles de connexion supplémentaires."]
                    </p>
                </div>
                <div class="setting-nested field-narrow">
                    <input id="server-name" type="text" class="form-control font-monospace" placeholder="@L["dns.exemple.fr"]" @bind="ServerName" @bind:event="oninput" />
                </div>
            </div>

            <div class="setting setting-stacked">
                <div class="setting-text">
                    <span class="setting-label">@L["Ports d'écoute"]</span>
                    <p class="setting-help">
                        @L["Pris en compte lorsque le chiffrement est activé. Le port HTTPS sert aussi le DNS-over-HTTPS sur"] <code>/dns-query</code>.
                    </p>
                </div>
                <div class="setting-nested field-grid">
                    <div>
                        <label class="form-label" for="https-port">HTTPS</label>
                        <input id="https-port" type="number" min="1" max="65535" class="form-control" @bind="HttpsPort" @bind:event="oninput" />
                    </div>
                    <div>
                        <label class="form-label" for="dot-port">DNS-over-TLS</label>
                        <input id="dot-port" type="number" min="1" max="65535" class="form-control" @bind="DnsOverTlsPort" @bind:event="oninput" />
                    </div>
                    <div>
                        <label class="form-label" for="doq-port">DNS-over-QUIC</label>
                        <input id="doq-port" type="number" min="1" max="65535" class="form-control" @bind="DnsOverQuicPort" @bind:event="oninput" />
                    </div>
                </div>
            </div>

            @if (SavedSettings.EnableEncryption)
            {
                <div class="setting setting-stacked">
                    <div class="https-status" role="status">
                        @if (HttpsStatus.Active)
                        {
                            <span class="state-pill state-pill-on">@L["HTTPS actif"]</span>
                            <span>
                                @L["Interface :"] <a href="@HttpsBaseUrl">@HttpsBaseUrl</a> · DNS-over-HTTPS :
                                <span class="mono">@(HttpsBaseUrl)dns-query</span>
                            </span>
                        }
                        else
                        {
                            <span class="state-pill state-pill-off">@L["HTTPS inactif"]</span>
                            <span>@(string.IsNullOrEmpty(HttpsStatus.Reason) ? L["vérification en cours…"] : char.ToUpperInvariant(HttpsStatus.Reason[0]) + HttpsStatus.Reason[1..] + ".")</span>
                        }
                    </div>
                </div>
            }

            <h3 class="setting-group-title">@L["Certificat et clé"]</h3>

            @if (LetsEncryptEnabled)
            {
                <div class="setting setting-stacked">
                    <p class="setting-help mb-0">
                        @L["Le certificat Let's Encrypt (section suivante) remplace le certificat et la clé fournis à la main, conservés pour le cas où vous le désactiveriez."]
                    </p>
                </div>
            }
            else
            {
                <div class="setting setting-stacked">
                    <div class="setting-text">
                        <span class="setting-label">@L["Chaîne de certificats"]</span>
                        <p class="setting-help">
                            @L["Certificat valide pour votre domaine (PEM, ou PKCS#12 sans mot de passe). Les certificats intermédiaires du fichier sont envoyés aux appareils."]
                        </p>
                    </div>
                    <div class="setting-nested">
                        <div class="segmented mb-3" role="radiogroup" aria-label="@L["Source du certificat"]">
                            <input class="btn-check" type="radio" name="certificate-source" id="cert-source-path" checked="@(CertificateSource == CertificateInputSource.FilePath)" @onchange="() => SetCertificateSource(CertificateInputSource.FilePath)" />
                            <label class="segmented-option" for="cert-source-path">@L["Chemin du fichier"]</label>
                            <input class="btn-check" type="radio" name="certificate-source" id="cert-source-paste" checked="@(CertificateSource == CertificateInputSource.PastedContent)" @onchange="() => SetCertificateSource(CertificateInputSource.PastedContent)" />
                            <label class="segmented-option" for="cert-source-paste">@L["Contenu PEM"]</label>
                        </div>

                        @if (CertificateSource == CertificateInputSource.FilePath)
                        {
                            <input type="text"
                                   class="form-control font-monospace"
                                   aria-label="@L["Chemin du fichier de certificats"]"
                                   placeholder="/etc/letsencrypt/live/dns.exemple.fr/fullchain.pem"
                                   @bind="CertificateFilePath"
                                   @bind:event="oninput" />
                        }
                        else
                        {
                            <textarea class="form-control font-monospace"
                                      rows="4"
                                      aria-label="@L["Contenu du certificat"]"
                                      placeholder="-----BEGIN CERTIFICATE-----"
                                      @bind="CertificateContent"
                                      @bind:event="oninput"></textarea>
                        }

                    </div>
                </div>

                <div class="setting setting-stacked">
                    <div class="setting-text">
                        <span class="setting-label">@L["Clé privée"]</span>
                        <p class="setting-help">
                            @L["Clé associée au certificat ci-dessus. Laissez vide si elle figure dans le même fichier."]
                        </p>
                    </div>
                    <div class="setting-nested">
                        <div class="segmented mb-3" role="radiogroup" aria-label="@L["Source de la clé privée"]">
                            <input class="btn-check" type="radio" name="private-key-source" id="key-source-path" checked="@(PrivateKeySource == CertificateInputSource.FilePath)" @onchange="() => SetPrivateKeySource(CertificateInputSource.FilePath)" />
                            <label class="segmented-option" for="key-source-path">@L["Chemin du fichier"]</label>
                            <input class="btn-check" type="radio" name="private-key-source" id="key-source-paste" checked="@(PrivateKeySource == CertificateInputSource.PastedContent)" @onchange="() => SetPrivateKeySource(CertificateInputSource.PastedContent)" />
                            <label class="segmented-option" for="key-source-paste">@L["Contenu PEM"]</label>
                        </div>

                        @if (PrivateKeySource == CertificateInputSource.FilePath)
                        {
                            <input type="text"
                                   class="form-control font-monospace"
                                   aria-label="@L["Chemin du fichier de clé privée"]"
                                   placeholder="/etc/letsencrypt/live/dns.exemple.fr/privkey.pem"
                                   @bind="PrivateKeyFilePath"
                                   @bind:event="oninput" />
                        }
                        else
                        {
                            <textarea class="form-control font-monospace"
                                      rows="4"
                                      aria-label="@L["Contenu de la clé privée"]"
                                      placeholder="-----BEGIN PRIVATE KEY-----"
                                      @bind="PrivateKeyContent"
                                      @bind:event="oninput"></textarea>
                        }

                    </div>
                </div>

                @if (ManualCertificateError is not null)
                {
                    <div class="setting setting-stacked">
                        <div class="alert alert-danger mb-0">@L["Certificat enregistré inutilisable : {0}", ManualCertificateError]</div>
                    </div>
                }
                else if (ManualCertificate is { } manual)
                {
                    <div class="setting setting-stacked">
                        <CertificateDetails Certificate="manual" ServerName="@SavedSettings.ServerName" />
                    </div>
                }
            }

            <div class="settings-panel-footer">
                <button type="button" class="btn btn-primary" @onclick="SaveEncryptionConfigurationAsync">@L["Enregistrer"]</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ResetEncryptionSettingsAsync">@L["Réinitialiser"]</button>
                @if (!string.IsNullOrEmpty(EncryptionStatusMessage))
                {
                    <div class="alert @(EncryptionStatusMessage.StartsWith(L["Erreur"], StringComparison.Ordinal) ? "alert-danger" : "alert-success")">@EncryptionStatusMessage</div>
                }
            </div>
        </div>
    </section>

    <section class="settings-section">
        <div class="settings-intro">
            <h2 class="settings-intro-title">@L["Certificat Let's Encrypt"]</h2>
            <p class="settings-intro-text">
                @L["Obtenu gratuitement et renouvelé sans intervention : OnyxFilter vérifie le certificat toutes les 12 heures et en demande un nouveau 15 jours avant son expiration."]
            </p>
        </div>

        <div class="card settings-panel">
            @if (SavedSettings.LetsEncrypt.Enabled || LetsEncryptStatus.Certificate is not null)
            {
                <div class="setting setting-stacked le-status" role="status">
                    <div class="le-status-head">
                        <span class="setting-label">@L["État"]</span>
                        @switch (LetsEncryptStatus.State)
                        {
                            case LetsEncryptState.Valid:
                                <span class="state-pill state-pill-on">@L["Valide"]</span>
                                break;
                            case LetsEncryptState.Issuing:
                                <span class="state-pill state-pill-busy">@L["En cours"]</span>
                                break;
                            case LetsEncryptState.Error:
                                <span class="state-pill state-pill-bad">@L["Échec"]</span>
                                break;
                            case LetsEncryptState.NotConfigured:
                                <span class="state-pill state-pill-warn">@L["À compléter"]</span>
                                break;
                            default:
                                <span class="state-pill state-pill-off">@L["Désactivé"]</span>
                                break;
                        }

                        @if (SavedSettings.LetsEncrypt.Enabled && LetsEncryptStatus.State != LetsEncryptState.NotConfigured)
                        {
                            <button type="button" class="btn btn-secondary btn-sm le-renew" @onclick="RenewNow" disabled="@LetsEncryptStatus.IsBusy">
                                <Icon Name="refresh" />@(LetsEncryptStatus.Certificate is null ? L["Obtenir le certificat"] : L["Renouveler maintenant"])
                            </button>
                        }
                    </div>

                    @if (LetsEncryptStatus.State == LetsEncryptState.Issuing)
                    {
                        <div class="le-progress">
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span>@(LetsEncryptStatus.Message ?? L["Demande en cours…"])</span>
                        </div>
                    }
                    else if (LetsEncryptStatus.State == LetsEncryptState.Error)
                    {
                        <div class="alert alert-danger mb-0">
                            @LetsEncryptStatus.Message
                            @if (LetsEncryptStatus.NextCheckUtc is { } retry)
                            {
                                <span> @L["Nouvel essai le {0}.", FormatDate(retry)]</span>
                            }
                        </div>
                    }
                    else if (LetsEncryptStatus.State == LetsEncryptState.NotConfigured)
                    {
                        <div class="alert alert-warning mb-0">@LetsEncryptStatus.Message</div>
                    }

                    @if (LetsEncryptStatus.Certificate is { } current)
                    {
                        <CertificateDetails Certificate="current.Summary" ServerName="@SavedSettings.ServerName" />

                        @if (LetsEncryptStatus.State == LetsEncryptState.Valid && LetsEncryptStatus.RenewalDueUtc is { } due)
                        {
                            <p class="setting-help mb-0">
                                @L["Renouvellement prévu le {0} ; prochaine vérification le {1}.", FormatDay(due), FormatDate(LetsEncryptStatus.NextCheckUtc)]
                                @L["Let's Encrypt limite à 5 par semaine les certificats demandés pour les mêmes noms."]
                            </p>
                        }
                    }
                    else if (LetsEncryptStatus.State is LetsEncryptState.Valid or LetsEncryptState.Disabled)
                    {
                        <p class="setting-help mb-0">@L["Aucun certificat obtenu pour l'instant."]</p>
                    }
                </div>
            }

            <div class="setting">
                <div class="setting-text">
                    <label class="setting-label" for="le-enabled">@L["Certificat automatique"]</label>
                    <p class="setting-help">
                        @L["Obtient un certificat Let's Encrypt pour"] <strong>@(string.IsNullOrWhiteSpace(ServerName) ? L["le nom de ce serveur"] : ServerName.Trim())</strong>
                        @L["et l'utilise à la place du certificat fourni à la main."]
                    </p>
                </div>
                <div class="form-check form-switch setting-control">
                    <input class="form-check-input" type="checkbox" role="switch" id="le-enabled" checked="@LetsEncryptEnabled" @onchange="OnLetsEncryptEnabledChanged" />
                </div>
            </div>

            @if (LetsEncryptEnabled)
            {
                <div class="setting setting-stacked">
                    <div class="alert alert-info mb-0">
                        @L["Conditions : le nom du serveur doit pointer, dans le DNS public, vers l'adresse publique de cette machine, et le port 80 doit lui parvenir depuis Internet (redirection de port sur la box) : Let's Encrypt s'y connecte pour vérifier que le domaine vous appartient."]
                    </div>
                </div>

                <div class="setting setting-stacked">
                    <div class="setting-text">
                        <label class="setting-label" for="le-domains">@L["Noms supplémentaires"]</label>
                        <p class="setting-help">
                            @L["Facultatif, un par ligne. Certificat demandé pour :"]
                            <span class="mono">@(LetsEncryptDomains.Count == 0 ? "—" : string.Join(", ", LetsEncryptDomains))</span>.
                        </p>
                    </div>
                    <div class="setting-nested">
                        <textarea id="le-domains" class="form-control font-monospace" rows="2"
                                  placeholder="@AdditionalDomainsPlaceholder"
                                  @bind="AdditionalDomainsText"
                                  @bind:event="oninput"></textarea>
                    </div>
                </div>

                <div class="setting setting-stacked">
                    <div class="setting-text">
                        <label class="setting-label" for="le-email">@L["Adresse e-mail"]</label>
                        <p class="setting-help">@L["Facultative, associée au compte Let's Encrypt."]</p>
                    </div>
                    <div class="setting-nested field-narrow">
                        <input id="le-email" type="email" class="form-control" placeholder="@L["vous@exemple.fr"]" @bind="LetsEncryptEmail" @bind:event="oninput" />
                    </div>
                </div>

                <div class="setting setting-stacked">
                    <div class="setting-text">
                        <span class="setting-label">@L["Environnement"]</span>
                        <p class="setting-help">
                            @L["L'environnement de test délivre des certificats non reconnus par les appareils, mais sans les limites d'émission : pratique pour vérifier la configuration."]
                        </p>
                    </div>
                    <div class="setting-nested">
                        <div class="segmented" role="radiogroup" aria-label="@L["Environnement Let's Encrypt"]">
                            <input class="btn-check" type="radio" name="le-environment" id="le-production" checked="@(!LetsEncryptUseStaging)" @onchange="() => SetLetsEncryptStaging(false)" />
                            <label class="segmented-option" for="le-production">@L["Production"]</label>
                            <input class="btn-check" type="radio" name="le-environment" id="le-staging" checked="@LetsEncryptUseStaging" @onchange="() => SetLetsEncryptStaging(true)" />
                            <label class="segmented-option" for="le-staging">@L["Test"]</label>
                        </div>
                    </div>
                </div>

                <div class="setting setting-stacked">
                    <div class="setting-text">
                        <label class="setting-label" for="le-port">@L["Port de validation"]</label>
                        <p class="setting-help">
                            @L["Port ouvert sur cette machine le temps de la validation. Let's Encrypt contacte toujours le port 80 : ne changez ce réglage que si la box redirige ce port vers un autre port de cette machine. S'il est déjà occupé, la validation passe par l'interface web."]
                        </p>
                    </div>
                    <div class="setting-nested field-narrow">
                        <input id="le-port" type="number" min="1" max="65535" class="form-control" @bind="LetsEncryptChallengePort" @bind:event="oninput" />
                    </div>
                </div>

                <div class="setting">
                    <div class="setting-text">
                        <label class="setting-label" for="le-terms">@L["Conditions d'utilisation"]</label>
                        <p class="setting-help">
                            @L["J'accepte les"]
                            <a href="@LetsEncryptPolicy.TermsOfServiceUrl" target="_blank" rel="noopener noreferrer">@L["conditions d'utilisation de Let's Encrypt"]</a>
                            @L["(obligatoire)."]
                        </p>
                    </div>
                    <div class="form-check form-switch setting-control">
                        <input class="form-check-input" type="checkbox" role="switch" id="le-terms" checked="@LetsEncryptAcceptTerms" @onchange="OnLetsEncryptAcceptTermsChanged" />
                    </div>
                </div>
            }

            <div class="settings-panel-footer">
                <button type="button" class="btn btn-primary" @onclick="SaveLetsEncryptConfigurationAsync">@L["Enregistrer"]</button>
                @if (!string.IsNullOrEmpty(LetsEncryptSaveMessage))
                {
                    <div class="alert @(LetsEncryptSaveMessage.StartsWith(L["Erreur"], StringComparison.Ordinal) ? "alert-danger" : "alert-success")">@LetsEncryptSaveMessage</div>
                }
            </div>
        </div>
    </section>

</div>
