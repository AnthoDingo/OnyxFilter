@page "/filters/countries"
@attribute [Authorize]
@rendermode InteractiveServer
@using OnyxFilter.Services.ClientLocation

<PageTitle>@L["Filtrage par pays"] · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">@L["Filtrage"]</p>
        <h1 class="page-title">@L["Filtrage par pays"]</h1>
        <p class="page-lead">@L["Refusez les requêtes des clients selon le pays de leur adresse IP."]</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@IsSaving">
            @(IsSaving ? L["Enregistrement…"] : L["Enregistrer"])
        </button>
    </div>
</header>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert page-status @(StatusIsError ? "alert-danger" : "alert-success")">@StatusMessage</div>
}

<div class="card settings-panel">
    <div class="setting setting-stacked">
        <div class="setting-text">
            <span class="setting-label">@L["Mode"]</span>
            <p class="setting-help">
                @L["Les clients du réseau local, et ceux des listes « Clients autorisés » ou « Clients toujours autorisés » des"]
                <a href="/settings/dns">@L["paramètres DNS"]</a>@L[", sont toujours servis. Un client refusé ne reçoit aucune réponse."]
            </p>
        </div>
        <div class="setting-nested">
            <div class="segmented" role="radiogroup" aria-label="@L["Mode du filtrage par pays"]">
                <input class="btn-check" type="radio" name="country-mode" id="country-mode-off" checked="@(Mode == CountryFilterMode.Disabled)" @onchange="() => Mode = CountryFilterMode.Disabled" />
                <label class="segmented-option" for="country-mode-off">@L["Désactivé"]</label>
                <input class="btn-check" type="radio" name="country-mode" id="country-mode-block" checked="@(Mode == CountryFilterMode.Blocklist)" @onchange="() => Mode = CountryFilterMode.Blocklist" />
                <label class="segmented-option" for="country-mode-block">@L["Bloquer les pays sélectionnés"]</label>
                <input class="btn-check" type="radio" name="country-mode" id="country-mode-allow" checked="@(Mode == CountryFilterMode.Allowlist)" @onchange="() => Mode = CountryFilterMode.Allowlist" />
                <label class="segmented-option" for="country-mode-allow">@L["N'autoriser que les pays sélectionnés"]</label>
            </div>

            @if (Mode != CountryFilterMode.Disabled && !LocationService.IsLoaded)
            {
                <div class="alert alert-warning">
                    @L["La base des pays (iptoasn.com) n'est pas encore chargée : elle est téléchargée après l'enregistrement. En attendant, tous les clients sont servis."]
                </div>
            }
        </div>
    </div>
</div>

<section class="card country-picker">
    <header class="country-picker-head">
        <h2 class="country-picker-title">
            @L["Pays sélectionnés"] <span class="country-picker-count">@SelectedCountries.Count</span>
        </h2>
        <div class="country-picker-tools">
            <input type="search" class="form-control form-control-sm" placeholder="@L["Rechercher un pays"]" aria-label="@L["Rechercher un pays"]" @bind="SearchText" @bind:event="oninput" />
            <button type="button" class="btn btn-link btn-sm" @onclick="SelectedCountries.Clear" disabled="@(SelectedCountries.Count == 0)">@L["Tout désélectionner"]</button>
        </div>
    </header>

    <div class="country-map @(Mode == CountryFilterMode.Disabled ? "is-disabled" : "")" @ref="mapContainer" role="group" aria-label="@L["Carte des pays"]">
        <div class="country-map-canvas"></div>
        <div class="country-map-tooltip" hidden>
            <span class="client-flag"></span><span class="country-map-tooltip-name"></span><span class="country-map-tooltip-state"></span>
        </div>
    </div>
    <p class="country-map-legend">
        <span class="country-map-key is-allowed" aria-hidden="true"></span>@L["Autorisé"]
        <span class="country-map-key is-blocked" aria-hidden="true"></span>@L["Bloqué"]
        <span class="country-map-hint">
            @(Mode == CountryFilterMode.Disabled
                ? L["Filtrage désactivé : la carte montre un aperçu du mode « Bloquer les pays sélectionnés »."]
                : L["Cliquez sur un pays de la carte pour l'autoriser ou l'interdire."])
        </span>
    </p>

    @if (AllCountries.Count == 0)
    {
        <p class="country-picker-empty">
            @L["La liste des pays sera disponible une fois la base des pays chargée. Activez le filtrage et enregistrez pour lancer son téléchargement."]
        </p>
    }
    else
    {
        List<(string Continent, List<string> Countries)> groups = VisibleGroups.ToList();

        @if (groups.Count == 0)
        {
            <p class="country-picker-empty">@L["Aucun pays ne correspond à la recherche."]</p>
        }

        @for (int groupIndex = 0; groupIndex < groups.Count; groupIndex++)
        {
            (string continent, List<string> countries) = groups[groupIndex];
            bool allSelected = countries.All(SelectedCountries.Contains);
            string headingId = "continent-" + groupIndex;
            <section class="country-group" aria-labelledby="@headingId">
                <header class="country-group-head">
                    <h3 class="country-group-title" id="@headingId">
                        @L[continent] <span class="country-picker-count">@SelectedCountOf(continent)/@TotalCountOf(continent)</span>
                    </h3>
                    <button type="button" class="btn btn-link btn-sm" @onclick="() => ToggleAll(countries, !allSelected)">
                        @(allSelected ? L["Tout désélectionner"] : L["Tout sélectionner"])
                    </button>
                </header>
                <div class="chip-set">
                    @foreach (string countryCode in countries)
                    {
                        string inputId = "country-" + countryCode;
                        <input class="btn-check" type="checkbox" id="@inputId" checked="@SelectedCountries.Contains(countryCode)" @onchange="e => ToggleCountry(countryCode, e)" />
                        <label class="chip-toggle" for="@inputId" title="@countryCode"><span class="client-flag">@FlagOf(countryCode)</span>@NameOf(countryCode)</label>
                    }
                </div>
            </section>
        }
    }
</section>
