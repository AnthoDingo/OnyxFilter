@page "/filters/countries"
@attribute [Authorize]
@rendermode InteractiveServer
@using OnyxFilter.Services.ClientLocation

<PageTitle>Filtrage par pays · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">Filtrage</p>
        <h1 class="page-title">Filtrage par pays</h1>
        <p class="page-lead">Refusez les requêtes des clients selon le pays de leur adresse IP.</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@IsSaving">
            @(IsSaving ? "Enregistrement…" : "Enregistrer")
        </button>
    </div>
</header>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert page-status @(StatusIsError ? "alert-danger" : "alert-success")">@StatusMessage</div>
}

<div class="card settings-panel">
    <div class="setting setting-stacked">
        <div class="setting-text">
            <span class="setting-label">Mode</span>
            <p class="setting-help">
                Les clients du réseau local, et ceux des listes « Clients autorisés » ou « Clients toujours
                autorisés » des <a href="/settings/dns">paramètres DNS</a>, sont toujours servis. Un client refusé
                ne reçoit aucune réponse.
            </p>
        </div>
        <div class="setting-nested">
            <div class="segmented" role="radiogroup" aria-label="Mode du filtrage par pays">
                <input class="btn-check" type="radio" name="country-mode" id="country-mode-off" checked="@(Mode == CountryFilterMode.Disabled)" @onchange="() => Mode = CountryFilterMode.Disabled" />
                <label class="segmented-option" for="country-mode-off">Désactivé</label>
                <input class="btn-check" type="radio" name="country-mode" id="country-mode-block" checked="@(Mode == CountryFilterMode.Blocklist)" @onchange="() => Mode = CountryFilterMode.Blocklist" />
                <label class="segmented-option" for="country-mode-block">Bloquer les pays sélectionnés</label>
                <input class="btn-check" type="radio" name="country-mode" id="country-mode-allow" checked="@(Mode == CountryFilterMode.Allowlist)" @onchange="() => Mode = CountryFilterMode.Allowlist" />
                <label class="segmented-option" for="country-mode-allow">N'autoriser que les pays sélectionnés</label>
            </div>

            @if (Mode != CountryFilterMode.Disabled && !LocationService.IsLoaded)
            {
                <div class="alert alert-warning">
                    La base des pays (iptoasn.com) n'est pas encore chargée : elle est téléchargée après
                    l'enregistrement. En attendant, tous les clients sont servis.
                </div>
            }
        </div>
    </div>
</div>

<section class="card country-picker">
    <header class="country-picker-head">
        <h2 class="country-picker-title">
            Pays sélectionnés <span class="country-picker-count">@SelectedCountries.Count</span>
        </h2>
        <div class="country-picker-tools">
            <input type="search" class="form-control form-control-sm" placeholder="Rechercher un pays" aria-label="Rechercher un pays" @bind="SearchText" @bind:event="oninput" />
            <button type="button" class="btn btn-link btn-sm" @onclick="SelectedCountries.Clear" disabled="@(SelectedCountries.Count == 0)">Tout désélectionner</button>
        </div>
    </header>

    @if (AllCountries.Count == 0)
    {
        <p class="country-picker-empty">
            La liste des pays sera disponible une fois la base des pays chargée. Activez le filtrage et
            enregistrez pour lancer son téléchargement.
        </p>
    }
    else
    {
        <div class="chip-set">
            @foreach (string countryCode in VisibleCountries)
            {
                string inputId = "country-" + countryCode;
                <input class="btn-check" type="checkbox" id="@inputId" checked="@SelectedCountries.Contains(countryCode)" @onchange="e => ToggleCountry(countryCode, e)" />
                <label class="chip-toggle" for="@inputId" title="@countryCode"><span class="client-flag">@FlagOf(countryCode)</span>@NameOf(countryCode)</label>
            }
        </div>
    }
</section>
