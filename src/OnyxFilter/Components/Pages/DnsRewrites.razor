@page "/filters/rewrites"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Réécritures DNS · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">Filtrage</p>
        <h1 class="page-title">
            Réécritures DNS
            <span class="state-pill @(RewritesEnabled ? "state-pill-on" : "state-pill-off")">@(RewritesEnabled ? "Actives" : "En pause")</span>
        </h1>
        <p class="page-lead">Répondez vous-même pour un domaine : adresse IP fixe ou redirection vers un autre nom.</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-secondary" @onclick="ToggleRewritesEnabledAsync">
            <Icon Name="@(RewritesEnabled ? "pause" : "play")" />@(RewritesEnabled ? "Mettre en pause" : "Réactiver")
        </button>
        <button type="button" class="btn btn-primary" @onclick="OpenAddDialog">
            <Icon Name="plus" />Ajouter une réécriture
        </button>
    </div>
</header>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert page-status @(StatusMessage.StartsWith("Erreur", StringComparison.Ordinal) ? "alert-danger" : "alert-success")">@StatusMessage</div>
}

<div class="card table-panel">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col" style="width: 4rem;">Active</th>
                    <th scope="col">Domaine</th>
                    <th scope="col" style="width: 2rem;"><span class="visually-hidden">vers</span></th>
                    <th scope="col">Réponse</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Entries.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="empty-state">
                            <span class="empty-state-title">Aucune réécriture</span>
                            Ajoutez-en une pour forcer la réponse d'un domaine.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (DnsRewriteEntry entry in PagedEntries)
                    {
                        <tr>
                            <td>
                                <div class="form-check form-switch cell-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" aria-label="Activer la réécriture de @entry.Domain" checked="@entry.Enabled" @onchange="e => ToggleEnabledAsync(entry, e)" />
                                </div>
                            </td>
                            <td class="mono">@entry.Domain</td>
                            <td class="rewrite-arrow" aria-hidden="true"><Icon Name="rewrites" /></td>
                            <td class="mono">@entry.Answer</td>
                            <td>
                                <div class="row-actions">
                                    <button type="button" class="btn btn-outline-primary btn-icon" title="Modifier" aria-label="Modifier la réécriture de @entry.Domain" @onclick="() => OpenEditDialog(entry)">
                                        <Icon Name="edit" />
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-icon" title="Supprimer" aria-label="Supprimer la réécriture de @entry.Domain" @onclick="() => RequestDelete(entry)">
                                        <Icon Name="trash" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Entries.Count > 0)
    {
        <div class="pagination-bar">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage <= 1)" @onclick="GoToPreviousPage">Précédent</button>

            <div class="pagination-bar-center">
                <span>Page @CurrentPage sur @TotalPages</span>
                <select class="form-select form-select-sm" aria-label="Lignes par page" value="@PageSize" @onchange="OnPageSizeChanged">
                    @foreach (int option in PageSizeOptions)
                    {
                        <option value="@option">@option par page</option>
                    }
                </select>
            </div>

            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage >= TotalPages)" @onclick="GoToNextPage">Suivant</button>
        </div>
    }
</div>

<p class="page-note">
    Une réécriture passe avant toute autre vérification (listes de blocage et d'autorisation, sécurité de
    navigation, contrôle parental, recherche sécurisée) : la réponse configurée ici l'emporte toujours pour le
    domaine concerné.
</p>

@if (ShowDialog)
{
    <div class="modal-backdrop-static" @onclick="CloseDialog"></div>

    <div class="modal-static" role="dialog" aria-modal="true" aria-labelledby="rewrite-dialog-title">
        <div class="card dialog-card">
            <div class="card-body">
                <h2 class="dialog-title" id="rewrite-dialog-title">@(IsEditMode ? "Modifier la réécriture" : "Nouvelle réécriture")</h2>
                <p class="dialog-lead">Le joker <code>*.</code> couvre tous les sous-domaines.</p>

                <div class="mb-3">
                    <label class="form-label" for="dialog-rewrite-domain">Domaine</label>
                    <input id="dialog-rewrite-domain" type="text" class="form-control font-monospace" placeholder="nas.maison ou *.exemple.fr" @bind="DialogDomain" @bind:event="oninput" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="dialog-rewrite-answer">Réponse</label>
                    <input id="dialog-rewrite-answer" type="text" class="form-control font-monospace" placeholder="192.168.1.20, ::1 ou autre.exemple.fr" @bind="DialogAnswer" @bind:event="oninput" />
                </div>

                @if (!string.IsNullOrEmpty(DialogError))
                {
                    <div class="alert alert-danger mb-0">@DialogError</div>
                }
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDialog" disabled="@IsSavingDialog">Annuler</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveDialogAsync" disabled="@IsSavingDialog">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm && EntryPendingDeletion is not null)
{
    <div class="modal-backdrop-static" @onclick="CancelDelete"></div>

    <div class="modal-static" role="alertdialog" aria-modal="true" aria-labelledby="delete-dialog-title">
        <div class="card dialog-card">
            <div class="card-body">
                <h2 class="dialog-title" id="delete-dialog-title">Supprimer la réécriture ?</h2>
                <p class="dialog-lead mb-0">
                    « @EntryPendingDeletion.Domain » sera de nouveau résolu normalement. Cette action est définitive.
                </p>
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">Annuler</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync">Supprimer</button>
                </div>
            </div>
        </div>
    </div>
}
