@page "/filters/rewrites"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>@L["Réécritures DNS"] · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">@L["Filtrage"]</p>
        <h1 class="page-title">
            @L["Réécritures DNS"]
            <span class="state-pill @(RewritesEnabled ? "state-pill-on" : "state-pill-off")">@(RewritesEnabled ? L["Actives"] : L["En pause"])</span>
        </h1>
        <p class="page-lead">@L["Répondez vous-même pour un domaine : adresse IP fixe ou redirection vers un autre nom."]</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-secondary" @onclick="ToggleRewritesEnabledAsync">
            <Icon Name="@(RewritesEnabled ? "pause" : "play")" />@(RewritesEnabled ? L["Mettre en pause"] : L["Réactiver"])
        </button>
        <button type="button" class="btn btn-primary" @onclick="OpenAddDialog">
            <Icon Name="plus" />@L["Ajouter une réécriture"]
        </button>
    </div>
</header>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert page-status @(StatusMessage.StartsWith(L["Erreur"], StringComparison.Ordinal) ? "alert-danger" : "alert-success")">@StatusMessage</div>
}

<div class="card table-panel">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col" style="width: 4rem;">@L["Active"]</th>
                    <th scope="col">@L["Domaine"]</th>
                    <th scope="col" style="width: 2rem;"><span class="visually-hidden">@L["vers"]</span></th>
                    <th scope="col">@L["Réponse"]</th>
                    <th scope="col"><span class="visually-hidden">@L["Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Entries.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="empty-state">
                            <span class="empty-state-title">@L["Aucune réécriture"]</span>
                            @L["Ajoutez-en une pour forcer la réponse d'un domaine."]
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (DnsRewriteEntry entry in PagedEntries)
                    {
                        <tr>
                            <td>
                                <div class="form-check form-switch cell-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" aria-label="@L["Activer la réécriture de {0}", entry.Domain]" checked="@entry.Enabled" @onchange="e => ToggleEnabledAsync(entry, e)" />
                                </div>
                            </td>
                            <td class="mono">@entry.Domain</td>
                            <td class="rewrite-arrow" aria-hidden="true"><Icon Name="rewrites" /></td>
                            <td class="mono">@entry.Answer</td>
                            <td>
                                <div class="row-actions">
                                    <button type="button" class="btn btn-outline-primary btn-icon" title="@L["Modifier"]" aria-label="@L["Modifier la réécriture de {0}", entry.Domain]" @onclick="() => OpenEditDialog(entry)">
                                        <Icon Name="edit" />
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-icon" title="@L["Supprimer"]" aria-label="@L["Supprimer la réécriture de {0}", entry.Domain]" @onclick="() => RequestDelete(entry)">
                                        <Icon Name="trash" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Entries.Count > 0)
    {
        <div class="pagination-bar">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage <= 1)" @onclick="GoToPreviousPage">@L["Précédent"]</button>

            <div class="pagination-bar-center">
                <span>@L["Page {0} sur {1}", CurrentPage, TotalPages]</span>
                <select class="form-select form-select-sm" aria-label="@L["Lignes par page"]" value="@PageSize" @onchange="OnPageSizeChanged">
                    @foreach (int option in PageSizeOptions)
                    {
                        <option value="@option">@L["{0} par page", option]</option>
                    }
                </select>
            </div>

            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage >= TotalPages)" @onclick="GoToNextPage">@L["Suivant"]</button>
        </div>
    }
</div>

<p class="page-note">
    @L["Une réécriture passe avant toute autre vérification (listes de blocage et d'autorisation, sécurité de navigation, contrôle parental, recherche sécurisée) : la réponse configurée ici l'emporte toujours pour le domaine concerné."]
</p>

@if (ShowDialog)
{
    <div class="modal-backdrop-static" @onclick="CloseDialog"></div>

    <div class="modal-static" role="dialog" aria-modal="true" aria-labelledby="rewrite-dialog-title">
        <div class="card dialog-card">
            <div class="card-body">
                <h2 class="dialog-title" id="rewrite-dialog-title">@(IsEditMode ? L["Modifier la réécriture"] : L["Nouvelle réécriture"])</h2>
                <p class="dialog-lead">@L["Le joker"] <code>*.</code> @L["couvre tous les sous-domaines."]</p>

                <div class="mb-3">
                    <label class="form-label" for="dialog-rewrite-domain">@L["Domaine"]</label>
                    <input id="dialog-rewrite-domain" type="text" class="form-control font-monospace" placeholder="@L["nas.maison ou *.exemple.fr"]" @bind="DialogDomain" @bind:event="oninput" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="dialog-rewrite-answer">@L["Réponse"]</label>
                    <input id="dialog-rewrite-answer" type="text" class="form-control font-monospace" placeholder="@L["192.168.1.20, ::1 ou autre.exemple.fr"]" @bind="DialogAnswer" @bind:event="oninput" />
                </div>

                @if (!string.IsNullOrEmpty(DialogError))
                {
                    <div class="alert alert-danger mb-0">@DialogError</div>
                }
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDialog" disabled="@IsSavingDialog">@L["Annuler"]</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveDialogAsync" disabled="@IsSavingDialog">@L["Enregistrer"]</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm && EntryPendingDeletion is not null)
{
    <div class="modal-backdrop-static" @onclick="CancelDelete"></div>

    <div class="modal-static" role="alertdialog" aria-modal="true" aria-labelledby="delete-dialog-title">
        <div class="card dialog-card">
            <div class="card-body">
                <h2 class="dialog-title" id="delete-dialog-title">@L["Supprimer la réécriture ?"]</h2>
                <p class="dialog-lead mb-0">
                    @L["« {0} » sera de nouveau résolu normalement. Cette action est définitive.", EntryPendingDeletion.Domain]
                </p>
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">@L["Annuler"]</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync">@L["Supprimer"]</button>
                </div>
            </div>
        </div>
    </div>
}
