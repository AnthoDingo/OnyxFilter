@page "/filters/blocked-services"
@attribute [Authorize]
@rendermode InteractiveServer
@using OnyxFilter.Services.BlockedServices

<PageTitle>@L["Services bloqués"] · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">@L["Filtrage"]</p>
        <h1 class="page-title">@L["Services bloqués"]</h1>
        <p class="page-lead">@L["Coupez l'accès à des plateformes entières en un geste, sans connaître leurs domaines."]</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-outline-success" @onclick="UnblockAll">@L["Tout autoriser"]</button>
        <button type="button" class="btn btn-outline-danger" @onclick="BlockAll">@L["Tout bloquer"]</button>
        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@IsSaving">
            @(IsSaving ? L["Enregistrement…"] : L["Enregistrer"])
        </button>
    </div>
</header>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert page-status @(StatusMessage.StartsWith(L["Erreur"], StringComparison.Ordinal) ? "alert-danger" : "alert-success")">@StatusMessage</div>
}

<div class="service-groups">
    @foreach ((string Id, string Label, IReadOnlyList<BlockedServiceDefinition> Services) group in GroupedServices)
    {
        <section class="service-group">
            <header class="service-group-head">
                <h2 class="service-group-title">@L[group.Label] <span class="service-group-count">@group.Services.Count</span></h2>
                <div class="service-group-actions">
                    <button type="button" class="btn btn-link btn-sm" @onclick="() => UnblockAllInGroup(group.Id)">@L["Tout autoriser"]</button>
                    <button type="button" class="btn btn-link btn-sm text-danger" @onclick="() => BlockAllInGroup(group.Id)">@L["Tout bloquer"]</button>
                </div>
            </header>

            <div class="service-grid">
                @foreach (BlockedServiceDefinition service in group.Services)
                {
                    string inputId = "service-" + service.Id;
                    <label class="service-tile @(IsBlocked(service.Id) ? "is-blocked" : "")" for="@inputId">
                        <span class="service-icon" aria-hidden="true">@((MarkupString)service.Icon)</span>
                        <span class="service-text">
                            <span class="service-name">@service.Name</span>
                            <span class="service-state">@(IsBlocked(service.Id) ? L["Bloqué"] : L["Autorisé"])</span>
                        </span>
                        <span class="form-check form-switch cell-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="@inputId" checked="@IsBlocked(service.Id)" @onchange="e => ToggleService(service.Id, e)" />
                        </span>
                    </label>
                }
            </div>
        </section>
    }
</div>

<section class="card schedule-card">
    <div class="schedule-card-icon" aria-hidden="true"><Icon Name="clock" /></div>
    <div class="schedule-card-text">
        <h2 class="schedule-card-title">@L["Pause programmée"]</h2>
        <p class="schedule-card-desc">
            @L["Autorisez temporairement les services bloqués à certaines heures de la semaine (heure locale du serveur)."]
        </p>
    </div>
    <button type="button" class="btn btn-secondary" @onclick="OpenScheduleDialog">
        <Icon Name="plus" />@L["Nouvel horaire"]
    </button>
</section>

@if (ShowScheduleDialog)
{
    <div class="modal-backdrop-static" @onclick="CloseScheduleDialog"></div>

    <div class="modal-static" role="dialog" aria-modal="true" aria-labelledby="schedule-dialog-title">
        <div class="card dialog-card">
            <div class="card-body">
                <h2 class="dialog-title" id="schedule-dialog-title">@L["Pause programmée"]</h2>
                <p class="dialog-lead">@L["Pendant ces plages, les services bloqués redeviennent accessibles."]</p>

                <div class="schedule-days">
                    @for (int day = 0; day < 7; day++)
                    {
                        int dayIndex = day;
                        <div class="schedule-day">
                            <div class="form-check form-switch schedule-day-toggle">
                                <input class="form-check-input" type="checkbox" role="switch" id="@("schedule-day-" + dayIndex)" checked="@DialogDayEnabled[dayIndex]" @onchange="e => OnScheduleDayToggled(dayIndex, e)" />
                                <label class="form-check-label" for="@("schedule-day-" + dayIndex)">@L[DayLabels[dayIndex]]</label>
                            </div>
                            <input type="time" class="form-control form-control-sm" aria-label="@L["Début, {0}", L[DayLabels[dayIndex]]]" disabled="@(!DialogDayEnabled[dayIndex])" @bind="DialogDayStart[dayIndex]" />
                            <span class="schedule-day-sep" aria-hidden="true">→</span>
                            <input type="time" class="form-control form-control-sm" aria-label="@L["Fin, {0}", L[DayLabels[dayIndex]]]" disabled="@(!DialogDayEnabled[dayIndex])" @bind="DialogDayEnd[dayIndex]" />
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(ScheduleDialogError))
                {
                    <div class="alert alert-danger mb-0 mt-3">@ScheduleDialogError</div>
                }
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseScheduleDialog">@L["Annuler"]</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveScheduleAsync">@L["Enregistrer"]</button>
                </div>
            </div>
        </div>
    </div>
}
