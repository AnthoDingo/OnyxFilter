@page "/setup-guide"
@attribute [Authorize]

<PageTitle>@L["Guide d'installation"] · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">@L["Configuration"]</p>
        <h1 class="page-title">@L["Guide d'installation"]</h1>
        <p class="page-lead">@L["Faire passer les appareils de votre réseau par OnyxFilter."]</p>
    </div>
</header>

<div class="card placeholder-card">
    <span class="placeholder-icon" aria-hidden="true"><Icon Name="book" /></span>
    <h2 class="placeholder-title">@L["Guide en cours de rédaction"]</h2>
    <p class="placeholder-text">
        @L["En attendant, le plus simple est d'indiquer l'adresse IP de ce serveur comme serveur DNS dans les réglages DHCP de votre box ou de votre routeur : tous les appareils du réseau l'utiliseront automatiquement."]
    </p>
</div>
