@page "/filters/allowlists"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>@L["Listes d'autorisation"] · OnyxFilter</PageTitle>

<header class="page-header">
    <div class="page-heading">
        <p class="page-eyebrow">@L["Filtrage"]</p>
        <h1 class="page-title">@L["Listes d'autorisation"]</h1>
        <p class="page-lead">
            @L["Domaines toujours résolus normalement, même s'ils figurent dans une liste de blocage. Même format et même actualisation automatique que les listes de blocage."]
        </p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-secondary" @onclick="RefreshNowAsync" disabled="@IsRefreshing">
            <Icon Name="refresh" />@(IsRefreshing ? L["Actualisation…"] : L["Actualiser les listes"])
        </button>
        <button type="button" class="btn btn-primary" @onclick="OpenAddDialog">
            <Icon Name="plus" />@L["Ajouter une liste"]
        </button>
    </div>
</header>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert page-status @(StatusMessage.StartsWith(L["Erreur"], StringComparison.Ordinal) ? "alert-danger" : "alert-success")">@StatusMessage</div>
}

<div class="card table-panel">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col" style="width: 4rem;">@L["Active"]</th>
                    <th scope="col">@L["Liste"]</th>
                    <th scope="col">@L["Règles"]</th>
                    <th scope="col">@L["Dernière actualisation"]</th>
                    <th scope="col"><span class="visually-hidden">@L["Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Lists.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="empty-state">
                            <span class="empty-state-title">@L["Aucune liste d'autorisation"]</span>
                            @L["Ajoutez une liste pour exempter des domaines du blocage."]
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (FilterListEntry entry in PagedLists)
                    {
                        <tr>
                            <td>
                                <div class="form-check form-switch cell-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" aria-label="@L["Activer {0}", entry.Name]" checked="@entry.Enabled" @onchange="e => ToggleEnabledAsync(entry, e)" />
                                </div>
                            </td>
                            <td>
                                <span class="list-name">@entry.Name</span>
                                <span class="list-url" title="@entry.Url">@entry.Url</span>
                            </td>
                            <td class="mono @(string.IsNullOrEmpty(GetStatus(entry)?.LastError) ? "" : "list-error")" title="@(GetStatus(entry)?.LastError)">@FormatRuleCount(GetStatus(entry))</td>
                            <td class="text-body-secondary">@FormatLastUpdated(GetStatus(entry))</td>
                            <td>
                                <div class="row-actions">
                                    <button type="button" class="btn btn-outline-primary btn-icon" title="@L["Modifier"]" aria-label="@L["Modifier {0}", entry.Name]" @onclick="() => OpenEditDialog(entry)">
                                        <Icon Name="edit" />
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-icon" title="@L["Supprimer"]" aria-label="@L["Supprimer {0}", entry.Name]" @onclick="() => RequestDelete(entry)">
                                        <Icon Name="trash" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Lists.Count > 0)
    {
        <div class="pagination-bar">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage <= 1)" @onclick="GoToPreviousPage">@L["Précédent"]</button>

            <div class="pagination-bar-center">
                <span>@L["Page {0} sur {1}", CurrentPage, TotalPages]</span>
                <select class="form-select form-select-sm" aria-label="@L["Lignes par page"]" value="@PageSize" @onchange="OnPageSizeChanged">
                    @foreach (int option in PageSizeOptions)
                    {
                        <option value="@option">@L["{0} par page", option]</option>
                    }
                </select>
            </div>

            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage >= TotalPages)" @onclick="GoToNextPage">@L["Suivant"]</button>
        </div>
    }
</div>

<p class="page-note">
    @L["Un domaine autorisé n'est jamais bloqué par les"] <a href="/filters/blocklists">@L["listes de blocage abonnées"]</a>@L[", quelle que soit la réponse configurée dans"]
    <a href="/settings/dns">@L["Serveur DNS"]</a>. @L["Il reste soumis à la sécurité de navigation et au contrôle parental s'ils sont activés dans"]
    <a href="/settings/general">@L["Général"]</a>@L[", où se règle aussi la fréquence d'actualisation automatique."]
</p>

@if (ShowDialog)
{
    <div class="modal-backdrop-static" @onclick="CloseDialog"></div>

    <div class="modal-static" role="dialog" aria-modal="true" aria-labelledby="list-dialog-title">
        <div class="card dialog-card">
            <div class="card-body">
                <h2 class="dialog-title" id="list-dialog-title">@(IsEditMode ? L["Modifier la liste"] : L["Nouvelle liste d'autorisation"])</h2>
                <p class="dialog-lead">@L["La liste est téléchargée et analysée dès l'enregistrement."]</p>

                <div class="mb-3">
                    <label class="form-label" for="dialog-list-name">@L["Nom"]</label>
                    <input id="dialog-list-name" type="text" class="form-control" @bind="DialogName" @bind:event="oninput" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="dialog-list-url">@L["Adresse de la liste"]</label>
                    <input id="dialog-list-url" type="text" class="form-control font-monospace" placeholder="https://…" @bind="DialogUrl" @bind:event="oninput" />
                </div>

                @if (!string.IsNullOrEmpty(DialogError))
                {
                    <div class="alert alert-danger mb-0">@DialogError</div>
                }
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDialog" disabled="@IsSavingDialog">@L["Annuler"]</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveDialogAsync" disabled="@IsSavingDialog">
                        @(IsSavingDialog ? L["Téléchargement…"] : L["Enregistrer"])
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirm && EntryPendingDeletion is not null)
{
    <div class="modal-backdrop-static" @onclick="CancelDelete"></div>

    <div class="modal-static" role="alertdialog" aria-modal="true" aria-labelledby="delete-dialog-title">
        <div class="card dialog-card">
            <div class="card-body">
                <h2 class="dialog-title" id="delete-dialog-title">@L["Supprimer la liste ?"]</h2>
                <p class="dialog-lead mb-0">
                    @L["« {0} » ne sera plus utilisée pour autoriser des domaines. Cette action est définitive.", EntryPendingDeletion.Name]
                </p>
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">@L["Annuler"]</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync">@L["Supprimer"]</button>
                </div>
            </div>
        </div>
    </div>
}
