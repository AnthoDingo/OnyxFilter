<footer class="app-footer">
    <div class="app-footer-top">
        <nav class="app-footer-links">
            <a href="https://github.com/AnthoDingo/OnyxFilter" target="_blank" rel="noopener noreferrer">Page d'accueil</a>
            <a class="app-footer-report" href="https://github.com/AnthoDingo/OnyxFilter/issues/new" target="_blank" rel="noopener noreferrer">Signaler un problème</a>
        </nav>

        <div class="app-footer-controls">
            <div class="theme-switcher" role="group" aria-label="Thème">
                <button type="button"
                        class="theme-button @(SelectedTheme == AppTheme.Auto ? "theme-button-active" : "")"
                        @onclick="() => SelectTheme(AppTheme.Auto)"
                        title="Automatique"
                        aria-label="Thème automatique">
                    <span class="theme-icon theme-icon-auto" aria-hidden="true"></span>
                </button>
                <button type="button"
                        class="theme-button @(SelectedTheme == AppTheme.Dark ? "theme-button-active" : "")"
                        @onclick="() => SelectTheme(AppTheme.Dark)"
                        title="Sombre"
                        aria-label="Thème sombre">
                    <span class="theme-icon theme-icon-dark" aria-hidden="true"></span>
                </button>
                <button type="button"
                        class="theme-button @(SelectedTheme == AppTheme.Light ? "theme-button-active" : "")"
                        @onclick="() => SelectTheme(AppTheme.Light)"
                        title="Clair"
                        aria-label="Thème clair">
                    <span class="theme-icon theme-icon-light" aria-hidden="true"></span>
                </button>
            </div>

            <div class="app-footer-language" title="Langue">
                <span class="app-footer-language-icon" aria-hidden="true"></span>
                <span>Français</span>
                <span class="app-footer-language-chevron" aria-hidden="true">▾</span>
            </div>
        </div>
    </div>

    <div class="app-footer-bottom">
        <span>Copyleft © @CurrentYear OnyxFilter</span>

        <span class="app-footer-version">
            version : @AssemblyVersion
            <button type="button" class="app-footer-refresh" @onclick="CheckForUpdatesAsync" aria-label="Vérifier les mises à jour">
                <span class="app-footer-refresh-icon" aria-hidden="true"></span>
            </button>
        </span>
    </div>
</footer>
