<div class="panel">
    <div class="panel-header">
        <div class="panel-heading">
            <h2 class="panel-title">@Title</h2>
            <p class="panel-subtitle">@Subtitle</p>
        </div>
        <button type="button" class="panel-refresh" @onclick="HandleRefreshAsync" aria-label="Actualiser">
            <span class="panel-refresh-icon" aria-hidden="true"></span>
        </button>
    </div>
    <div class="panel-body">
        @ChildContent
    </div>
</div>
