<div class="stat-card">
    <div class="stat-card-top">
        <span class="stat-card-value">@FormattedValue</span>
        @if (PercentageText is not null)
        {
            <span class="stat-card-percentage @AccentCssClass">@PercentageText</span>
        }
    </div>
    <div class="stat-card-chart">
        <svg viewBox="0 0 300 60" preserveAspectRatio="none" class="stat-card-sparkline @AccentCssClass" aria-hidden="true">
            @if (!string.IsNullOrEmpty(AreaPath))
            {
                <path class="stat-card-area" d="@AreaPath" />
            }
            <path class="stat-card-line" d="@LinePath" />
        </svg>
    </div>
    <div class="stat-card-label @AccentCssClass">@Label</div>
</div>
