@page "/filters/blocked-services"
@attribute [Authorize]
@rendermode InteractiveServer
@using OnyxFilter.Services.BlockedServices

<PageTitle>Services bloqués - OnyxFilter</PageTitle>

<h1 class="page-title">Services bloqués</h1>
<p class="text-body-secondary">Permet de bloquer les sites et services populaires rapidement.</p>

<div class="settings-page">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">

            <div class="card mb-4">
                <div class="card-body">
                    <div class="row g-2 mb-4">
                        <div class="col-md-6">
                            <button type="button" class="btn btn-outline-danger w-100" @onclick="BlockAll">Tout bloquer</button>
                        </div>
                        <div class="col-md-6">
                            <button type="button" class="btn btn-outline-success w-100" @onclick="UnblockAll">Tout débloquer</button>
                        </div>
                    </div>

                    @foreach ((string Id, string Label, IReadOnlyList<BlockedServiceDefinition> Services) group in GroupedServices)
                    {
                        <div class="blocked-services-group mb-4">
                            <div class="d-flex align-items-center flex-wrap gap-3 mb-2">
                                <h2 class="fs-6 mb-0">@group.Label</h2>
                                <button type="button" class="btn btn-link btn-sm text-danger p-0 text-decoration-none" @onclick="() => BlockAllInGroup(group.Id)">Tout bloquer</button>
                                <button type="button" class="btn btn-link btn-sm text-success p-0 text-decoration-none" @onclick="() => UnblockAllInGroup(group.Id)">Tout débloquer</button>
                            </div>

                            <div class="row row-cols-1 row-cols-md-3 g-2">
                                @foreach (BlockedServiceDefinition service in group.Services)
                                {
                                    <div class="col">
                                        <div class="blocked-service-row">
                                            <span class="blocked-service-icon">@((MarkupString)service.Icon)</span>
                                            <span class="blocked-service-name">@service.Name</span>
                                            <div class="form-check form-switch ms-auto mb-0">
                                                <input class="form-check-input" type="checkbox" role="switch" checked="@IsBlocked(service.Id)" @onchange="e => ToggleService(service.Id, e)" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <button type="button" class="btn btn-success" @onclick="SaveAsync" disabled="@IsSaving">
                        @(IsSaving ? "Enregistrement..." : "Enregistrer")
                    </button>

                    @if (!string.IsNullOrEmpty(StatusMessage))
                    {
                        <div class="alert @(StatusMessage.StartsWith("Erreur", StringComparison.Ordinal) ? "alert-danger" : "alert-success") py-2 mt-3 mb-0">@StatusMessage</div>
                    }
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="fs-5">Suspendre le blocage des services</h2>
                    <p class="text-body-secondary mb-3">Configurez l'horaire de pause du filtre de blocage de services.</p>

                    <p class="mb-3">Fuseau horaire actuel : Local</p>

                    <button type="button" class="btn btn-success" @onclick="OpenScheduleDialog">Nouvel horaire</button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowScheduleDialog)
{
    <div class="modal-backdrop-static" @onclick="CloseScheduleDialog"></div>

    <div class="modal-static">
        <div class="card" style="width: 34rem; max-width: 92vw;">
            <div class="card-body">
                <h2 class="card-title fs-5">Horaire de suspension du blocage des services</h2>

                @for (int day = 0; day < 7; day++)
                {
                    int dayIndex = day;
                    <div class="schedule-day-row mb-2">
                        <div class="form-check schedule-day-checkbox">
                            <input class="form-check-input" type="checkbox" id="@("schedule-day-" + dayIndex)" checked="@DialogDayEnabled[dayIndex]" @onchange="e => OnScheduleDayToggled(dayIndex, e)" />
                            <label class="form-check-label" for="@("schedule-day-" + dayIndex)">@DayLabels[dayIndex]</label>
                        </div>
                        <input type="time" class="form-control form-control-sm" disabled="@(!DialogDayEnabled[dayIndex])" @bind="DialogDayStart[dayIndex]" />
                        <span>—</span>
                        <input type="time" class="form-control form-control-sm" disabled="@(!DialogDayEnabled[dayIndex])" @bind="DialogDayEnd[dayIndex]" />
                    </div>
                }

                @if (!string.IsNullOrEmpty(ScheduleDialogError))
                {
                    <div class="alert alert-danger py-2 mb-0 mt-2">@ScheduleDialogError</div>
                }
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-success" @onclick="SaveScheduleAsync">Enregistrer</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseScheduleDialog">Annuler</button>
                </div>
            </div>
        </div>
    </div>
}
