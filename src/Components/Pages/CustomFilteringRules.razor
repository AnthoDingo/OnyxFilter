@page "/filters/custom-rules"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Règles de filtrage personnalisées - OnyxFilter</PageTitle>

<h1 class="page-title">Règles de filtrage personnalisées</h1>

<div class="settings-page">
    <div class="row justify-content-center">
        <div class="col-md-10 col-12">

            <div class="card mb-4">
                <div class="card-body">
                    <p class="mb-3">
                        Saisissez la règle en une ligne. C'est possible d'utiliser les règles de blocage ou la
                        syntaxe des fichiers hosts.
                    </p>

                    <div class="mb-3">
                        <textarea class="form-control custom-rules-textarea" @bind="RulesText" @bind:event="oninput"></textarea>
                    </div>

                    <button type="button" class="btn btn-success mb-3" @onclick="ApplyAsync" disabled="@IsSaving">
                        @(IsSaving ? "Enregistrement..." : "Appliquer")
                    </button>

                    @if (!string.IsNullOrEmpty(StatusMessage))
                    {
                        <div class="alert @(StatusMessage.StartsWith("Erreur", StringComparison.Ordinal) ? "alert-danger" : "alert-success") py-2 mb-3">@StatusMessage</div>
                    }

                    <hr />

                    <p class="mb-2">Exemples:</p>
                    <ol class="mb-3">
                        <li><code>||example.org^</code> : bloque l'accès au domaine example.org et à tous ses sous-domaines ;</li>
                        <li><code>@@@@||example.org^</code> : débloque l'accès au domaine example.org et à tous ses sous-domaines ;</li>
                        <li><code>127.0.0.1 example.org</code> : OnyxFilter va retourner l'adresse 127.0.0.1 au domaine example.org (mais pas aux sous-domaines) ;</li>
                        <li><code>! Voici un commentaire.</code> : juste un commentaire ;</li>
                        <li><code># Aussi un commentaire.</code> : juste un commentaire ;</li>
                        <li><code>/REGEX/</code> : bloque l'accès aux domaines correspondants à l'expression régulière spécifiée.</li>
                    </ol>

                    <a href="https://github.com/AdguardTeam/AdGuardHome/wiki/Hosts-Blocklists" target="_blank" rel="noopener noreferrer">Apprenez plus</a>
                    sur la création de vos propres listes hosts.
                </div>
            </div>
        </div>
    </div>
</div>
