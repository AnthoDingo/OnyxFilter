@page "/filters/check"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Vérification du filtrage - OnyxFilter</PageTitle>

<h1 class="page-title">Vérification du filtrage</h1>
<p class="text-body-secondary">Vérifier si le nom d'hôte est filtré.</p>

<div class="settings-page">
    <div class="row justify-content-center">
        <div class="col-md-8 col-12">

            <div class="card mb-4">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="check-host">Nom d'hôte ou nom de domaine</label>
                        <input id="check-host" type="text" class="form-control" placeholder="example.com" @bind="HostName" @bind:event="oninput" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="check-client">Identifiant du client (ClientID ou adresse IP)</label>
                        <input id="check-client" type="text" class="form-control" placeholder="Saisissez l'identifiant du client" @bind="ClientIdentifier" @bind:event="oninput" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="check-record-type">Sélectionnez le type d'enregistrement DNS</label>
                        <select id="check-record-type" class="form-select" value="@SelectedRecordType" @onchange="OnRecordTypeChanged">
                            @foreach ((string Label, ushort Type) option in RecordTypeOptions)
                            {
                                <option value="@option.Type">@option.Label</option>
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger py-2 mb-3">@ErrorMessage</div>
                    }

                    <button type="button" class="btn btn-success" @onclick="CheckAsync" disabled="@IsChecking">
                        @(IsChecking ? "Vérification..." : "Vérifier")
                    </button>

                    @if (!string.IsNullOrEmpty(ResultMessage))
                    {
                        <div class="alert @ResultCssClass py-2 mt-3 mb-0">@ResultMessage</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
