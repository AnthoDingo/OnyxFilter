@page "/settings/dns"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Paramètres DNS - OnyxFilter</PageTitle>

<h1 class="page-title">Paramètres DNS</h1>

<div class="settings-page">

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title fs-5">Serveurs DNS upstream</h2>

            <p class="text-body-secondary">
                Saisissez les adresses des serveurs, une par ligne.
                <span class="text-primary">En savoir plus</span>
                sur la configuration des serveurs DNS en amont. Voici une
                <span class="text-primary">liste de fournisseurs DNS connus</span>.
            </p>

            <textarea class="form-control font-monospace mb-3" rows="8" @bind="UpstreamServersText" @bind:event="oninput"></textarea>

            <div class="small text-body-secondary">
                <p class="mb-2">Exemples :</p>
                <ol>
                    <li><code>94.140.14.140, 2a10:50c0::1:ff</code> : DNS classique (au-dessus de UDP) ;</li>
                    <li><code>94.140.14.140:53, [2a10:50c0::1:ff]:53</code> : DNS normal (sur UDP, avec port) ;</li>
                    <li><code>udp://unfiltered.adguard-dns.com</code> : DNS normal (sur UDP, nom d'hôte) ;</li>
                    <li><code>tcp://94.140.14.140, tcp://[2a10:50c0::1:ff]</code> : DNS classique (au-dessus de TCP) ;</li>
                    <li><code>tcp://94.140.14.140:53, tcp://[2a10:50c0::1:ff]:53</code> : DNS normal (sur TCP, avec port) ;</li>
                    <li><code>tcp://unfiltered.adguard-dns.com</code> : DNS normal (sur TCP, nom d'hôte) ;</li>
                    <li>
                        <code>tls://unfiltered.adguard-dns.com</code> :
                        <a href="https://en.wikipedia.org/wiki/DNS_over_TLS" target="_blank" rel="noopener noreferrer">DNS-over-TLS</a>
                        chiffré ;
                    </li>
                    <li>
                        <code>https://unfiltered.adguard-dns.com/dns-query</code> :
                        <a href="https://en.wikipedia.org/wiki/DNS_over_HTTPS" target="_blank" rel="noopener noreferrer">DNS-over-HTTPS</a>
                        chiffré ;
                    </li>
                    <li>
                        <code>h3://unfiltered.adguard-dns.com/dns-query</code> : DNS-over-HTTPS chiffré avec
                        <a href="https://en.wikipedia.org/wiki/HTTP/3" target="_blank" rel="noopener noreferrer">HTTP/3</a>
                        forcé sans repli sur HTTP/2 ou inférieur ;
                    </li>
                    <li>
                        <code>quic://unfiltered.adguard-dns.com</code> :
                        <a href="https://en.wikipedia.org/wiki/DNS_over_QUIC" target="_blank" rel="noopener noreferrer">DNS-over-QUIC</a>
                        chiffré;
                    </li>
                    <li>
                        <code>sdns://...</code> : vous pouvez utiliser
                        <a href="https://dnscrypt.info/stamps-specifications" target="_blank" rel="noopener noreferrer">DNS Stamps</a>
                        pour
                        <a href="https://en.wikipedia.org/wiki/DNSCrypt" target="_blank" rel="noopener noreferrer">DNSCrypt</a>
                        ou les résolveurs
                        <a href="https://en.wikipedia.org/wiki/DNS_over_HTTPS" target="_blank" rel="noopener noreferrer">DNS_over_HTTPS</a>
                        ;
                    </li>
                    <li>
                        <code>[/example.local/]94.140.14.140</code> : un amont
                        <span class="text-primary">pour des domaines spécifiques</span>
                        ;
                    </li>
                    <li>
                        <code>[/example.local/]94.140.14.140 2a10:50c0::1:ff</code> : plusieurs amonts
                        <span class="text-primary">pour des domaines spécifiques</span>
                        ;
                    </li>
                    <li><code># comment</code> : un commentaire.</li>
                </ol>
            </div>

            <hr />

            <h2 class="card-title fs-5">Mode de résolution</h2>

            <div class="form-check mb-3">
                <input class="form-check-input"
                       type="radio"
                       name="resolution-mode"
                       id="mode-load-balancing"
                       checked="@(ResolutionMode == UpstreamResolutionMode.LoadBalancing)"
                       @onchange="() => SetResolutionMode(UpstreamResolutionMode.LoadBalancing)" />
                <label class="form-check-label fw-semibold" for="mode-load-balancing">Équilibrage de charge</label>
                <div class="form-text">
                    Une requête par serveur en amont à la fois. OnyxFilter utilise un algorithme aléatoire pondéré
                    pour sélectionner les serveurs avec le plus petit nombre d'échecs de recherche et le temps de
                    recherche moyen le plus bas.
                </div>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input"
                       type="radio"
                       name="resolution-mode"
                       id="mode-parallel"
                       checked="@(ResolutionMode == UpstreamResolutionMode.Parallel)"
                       @onchange="() => SetResolutionMode(UpstreamResolutionMode.Parallel)" />
                <label class="form-check-label fw-semibold" for="mode-parallel">Requêtes en parallèle</label>
                <div class="form-text">
                    Utilisez des requêtes parallèles pour accélérer la résolution en requêtant simultanément tous
                    les serveurs en amont.
                </div>
            </div>

            <div class="form-check">
                <input class="form-check-input"
                       type="radio"
                       name="resolution-mode"
                       id="mode-fastest"
                       checked="@(ResolutionMode == UpstreamResolutionMode.FastestAddress)"
                       @onchange="() => SetResolutionMode(UpstreamResolutionMode.FastestAddress)" />
                <label class="form-check-label fw-semibold" for="mode-fastest">Adresse IP la plus rapide</label>
                <div class="form-text">
                    Attente des réponses de <strong>tous</strong> les serveurs DNS, mesure de la vitesse de
                    connexion TCP pour chaque serveur et renvoi de l'adresse IP du serveur avec la vitesse de
                    connexion la plus rapide.
                    Ce mode peut considérablement ralentir les requêtes DNS, si un ou plusieurs serveurs en amont
                    ne répondent pas. Assurez-vous que vos serveurs en amont sont stables et que votre délai
                    dépassé en amont est faible.
                </div>
            </div>

            <hr />
            
            <h2 class="card-title fs-5">Serveurs DNS de repli</h2>

            <p class="text-body-secondary">
                Liste des serveurs DNS de repli utilisés lorsque les serveurs DNS en amont ne répondent pas. La
                syntaxe est la même que dans le champ principal en amont ci-dessus.
            </p>

            <textarea class="form-control font-monospace"
                      rows="4"
                      placeholder="Saisissez un serveur DNS de repli par ligne"
                      @bind="FallbackServersText"
                      @bind:event="oninput"></textarea>

            <hr />

            <h2 class="card-title fs-5">Serveurs DNS d'amorçage</h2>

            <p class="text-body-secondary">
                Les adresses IP des serveurs DNS utilisées pour résoudre les adresses IP des résolveurs DoH/DoT
                que vous spécifiez comme en amont. Les commentaires ne sont pas autorisés.
            </p>

            <textarea class="form-control font-monospace" rows="4" @bind="BootstrapServersText" @bind:event="oninput"></textarea>

            <hr />
            
            <h2 class="card-title fs-5">Serveurs DNS privés inverses</h2>

            <p class="text-body-secondary">
                Les serveurs DNS utilisés par OnyxFilter pour les requêtes privées PTR, SOA et NS. Une requête
                est considérée privée si elle demande un domaine ARPA contenant un sous-réseau entre les plages
                IP privées (par exemple « 192.168.12.34 ») et provient d'un client avec une adresse IP privée.
                Sans réglages additionnels, les résolveurs DNS par défaut de votre système d'exploitation seront
                utilisés, sauf pour les adresses IP d'OnyxFilter.
            </p>

            <p class="text-body-secondary">
                Par défaut, OnyxFilter utilise les résolveurs DNS inversés suivants : « 8.8.4.4:53 », «
                8.8.8.8:53 ».
            </p>

            <textarea class="form-control font-monospace"
                      rows="3"
                      placeholder="Saisissez une adresse IP par ligne"
                      @bind="ReversePrivateServersText"
                      @bind:event="oninput"></textarea>

            <hr />

            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="use-private-reverse-resolvers" checked="@UsePrivateReverseResolvers" @onchange="OnUsePrivateReverseResolversChanged" />
                <label class="form-check-label fw-semibold" for="use-private-reverse-resolvers">Utiliser des résolveurs DNS inversés privés</label>
                <div class="form-text">
                    Résolvez les requêtes PTR, SOA et NS pour les domaines ARPA contenant des adresses IP privées
                    par aide des serveurs privés en amont, DHCP, /etc/hosts, etc. S'il est désactivé, OnyxFilter
                    répondra à toutes ces requêtes avec NXDOMAIN.
                </div>
            </div>

            <hr />
            
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="enable-client-ip-reverse-resolution" checked="@EnableClientIpReverseResolution" @onchange="OnEnableClientIpReverseResolutionChanged" />
                <label class="form-check-label fw-semibold" for="enable-client-ip-reverse-resolution">Activer la résolution inverse des adresses IP des clients</label>
                <div class="form-text">
                    Résoudre inversement les adresses IP des clients en leurs noms d'hôtes en envoyant des
                    requêtes PTR aux résolveurs correspondants (serveurs DNS privés pour les clients locaux,
                    serveurs en amont pour les clients ayant une adresse IP publique).
                </div>
            </div>
        </div>

        <div class="card-footer">
            <div class="d-flex gap-2 mt-2 mb-2">
                <button type="button" class="btn btn-primary">Tester les upstreams</button>
                <button type="button" class="btn btn-success" @onclick="ValidateDnsServerSettingsAsync">Enregistrer</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ResetDnsServerSettingsAsync">Réinitialiser</button>
            </div>

            @if (!string.IsNullOrEmpty(DnsServersStatusMessage))
            {
                <div class="alert @(DnsServersStatusMessage.StartsWith("Erreur", StringComparison.Ordinal) ? "alert-danger" : "alert-success") py-2 mb-4">@DnsServersStatusMessage</div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title fs-5">Configuration du serveur DNS</h2>

            <div class="row mb-3">
                <div class="col-md-6 col-12">
                    <label class="form-label" for="rate-limit">Limite de requêtes par seconde</label>
                    <input id="rate-limit" type="number" min="0" class="form-control" @bind="RateLimitPerSecond" @bind:event="oninput" />
                    <div class="form-text">
                        Nombre maximal de requêtes autorisées par seconde pour une même adresse IP. La valeur 0
                        désactive la limite.
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6 col-12">
                    <label class="form-label" for="subnet-ipv4">Longueur de préfixe du sous-réseau pour les adresses IPv4</label>
                    <input id="subnet-ipv4" type="number" min="0" max="32" class="form-control" @bind="RateLimitSubnetLengthIpv4" @bind:event="oninput" />
                    <div class="form-text">Utilisée pour regrouper les adresses IPv4 lors de l'application de la limite de requêtes.</div>
                </div>

                <div class="col-md-6 col-12">
                    <label class="form-label" for="subnet-ipv6">Longueur de préfixe du sous-réseau pour les adresses IPv6</label>
                    <input id="subnet-ipv6" type="number" min="0" max="128" class="form-control" @bind="RateLimitSubnetLengthIpv6" @bind:event="oninput" />
                    <div class="form-text">Utilisée pour regrouper les adresses IPv6 lors de l'application de la limite de requêtes.</div>
                </div>
            </div>

            <hr />

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="enable-edns" checked="@EnableEdnsClientSubnet" @onchange="OnEnableEdnsClientSubnetChanged" />
                <label class="form-check-label fw-semibold" for="enable-edns">Activer le sous-réseau client (EDNS)</label>
                <div class="form-text">
                    Utiliser l'extension EDNS Client Subnet pour transmettre une partie de l'adresse IP du client
                    aux serveurs en amont, afin d'obtenir des réponses géographiquement plus pertinentes.
                </div>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="enable-dnssec" checked="@EnableDnssec" @onchange="OnEnableDnssecChanged" />
                <label class="form-check-label fw-semibold" for="enable-dnssec">Activer DNSSEC</label>
                <div class="form-text">Vérifier la signature DNSSEC des réponses lorsque les serveurs en amont la fournissent.</div>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="disable-ipv6" checked="@DisableIpv6Resolution" @onchange="OnDisableIpv6ResolutionChanged" />
                <label class="form-check-label fw-semibold" for="disable-ipv6">Désactiver la résolution IPv6</label>
                <div class="form-text">Toutes les requêtes de type AAAA renverront une réponse vide.</div>
            </div>

            <hr />

            <h3 class="fs-6 fw-semibold">Mode de blocage</h3>

            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="blocking-mode" id="blocking-default" checked="@(BlockingMode == DnsBlockingMode.Default)" @onchange="() => SetBlockingMode(DnsBlockingMode.Default)" />
                <label class="form-check-label" for="blocking-default">Par défaut</label>
                <div class="form-text">Utilise le mode NXDOMAIN ou une adresse IP nulle selon le type de filtre déclenché.</div>
            </div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="blocking-mode" id="blocking-nxdomain" checked="@(BlockingMode == DnsBlockingMode.NxDomain)" @onchange="() => SetBlockingMode(DnsBlockingMode.NxDomain)" />
                <label class="form-check-label" for="blocking-nxdomain">NXDOMAIN</label>
                <div class="form-text">Répond avec un statut NXDOMAIN, comme si le domaine n'existait pas.</div>
            </div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="blocking-mode" id="blocking-refused" checked="@(BlockingMode == DnsBlockingMode.Refused)" @onchange="() => SetBlockingMode(DnsBlockingMode.Refused)" />
                <label class="form-check-label" for="blocking-refused">REFUSED</label>
                <div class="form-text">Répond avec un statut REFUSED.</div>
            </div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="blocking-mode" id="blocking-nullip" checked="@(BlockingMode == DnsBlockingMode.NullIp)" @onchange="() => SetBlockingMode(DnsBlockingMode.NullIp)" />
                <label class="form-check-label" for="blocking-nullip">Adresse IP non spécifiée</label>
                <div class="form-text">Répond avec l'adresse IP non spécifiée (0.0.0.0 ou ::).</div>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="blocking-mode" id="blocking-customip" checked="@(BlockingMode == DnsBlockingMode.CustomIp)" @onchange="() => SetBlockingMode(DnsBlockingMode.CustomIp)" />
                <label class="form-check-label" for="blocking-customip">Adresse IP personnalisée</label>
                <div class="form-text">Répond avec les adresses IPv4/IPv6 spécifiées ci-dessous.</div>
            </div>

            @if (BlockingMode == DnsBlockingMode.CustomIp)
            {
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label" for="custom-blocking-ipv4">Adresse IPv4 de blocage</label>
                        <input id="custom-blocking-ipv4" type="text" class="form-control" @bind="CustomBlockingIpv4" @bind:event="oninput" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="custom-blocking-ipv6">Adresse IPv6 de blocage</label>
                        <input id="custom-blocking-ipv6" type="text" class="form-control" @bind="CustomBlockingIpv6" @bind:event="oninput" />
                    </div>
                </div>
            }
        </div>
        <div class="card-footer">
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-success" @onclick="SaveDnsServerConfigurationAsync">Enregistrer</button>
            </div>
            @if (!string.IsNullOrEmpty(ServerConfigStatusMessage))
            {
                <div class="alert @(ServerConfigStatusMessage.StartsWith("Erreur", StringComparison.Ordinal) ? "alert-danger" : "alert-success") py-2 mt-3 mb-0">@ServerConfigStatusMessage</div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title fs-5">Configuration du cache DNS</h2>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="enable-cache" checked="@EnableCache" @onchange="OnEnableCacheChanged" />
                <label class="form-check-label fw-semibold" for="enable-cache">Activer le cache</label>
                <div class="form-text">Conserver les réponses des serveurs en amont afin de répondre plus rapidement aux requêtes répétées.</div>
            </div>
             
            <hr />

            <div class="row mb-3">
                <div class="col-md-6 col-12">
                    <label class="form-label" for="cache-size">Taille du cache (en octets)</label>
                    <input id="cache-size" type="number" min="0" <class="form-control" @bind="CacheSizeBytes" @bind:event="oninput" />
                    <div class="form-text">La valeur 0 laisse OnyxFilter choisir automatiquement une taille par défaut.</div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="cache-ttl-min">Écrasement TTL minimum</label>
                    <input id="cache-ttl-min" type="number" min="0" class="form-control" @bind="CacheTtlMinSeconds" @bind:event="oninput" />
                    <div class="form-text">Si le TTL d'une réponse est inférieur à cette valeur, il est remplacé par celle-ci. 0 désactive l'écrasement.</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="cache-ttl-max">Écrasement TTL maximum</label>
                    <input id="cache-ttl-max" type="number" min="0" class="form-control" @bind="CacheTtlMaxSeconds" @bind:event="oninput" />
                    <div class="form-text">Si le TTL d'une réponse est supérieur à cette valeur, il est remplacé par celle-ci. 0 désactive l'écrasement.</div>
                </div>
            </div>

            <hr />

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="optimistic-cache" checked="@OptimisticCache" @onchange="OnOptimisticCacheChanged" />
                <label class="form-check-label fw-semibold" for="optimistic-cache">Cache optimiste</label>
                <div class="form-text">
                    Répondre à partir du cache même lorsque les entrées ont expiré, tout en tentant de les
                    rafraîchir en arrière-plan.
                </div>
            </div>          
        </div>
        <div class="card-footer">
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-success" @onclick="SaveCacheConfigurationAsync">Enregistrer</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearCacheAsync">Vider le cache</button>
            </div>  
            @if (!string.IsNullOrEmpty(CacheStatusMessage))
            {
                <div class="alert @(CacheStatusMessage.StartsWith("Erreur", StringComparison.Ordinal) ? "alert-danger" : "alert-success") py-2 mt-3 mb-0">@CacheStatusMessage</div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="card-title fs-5">Paramètres d'accès</h2>

            <div class="mb-3">
                <label class="form-label" for="allowed-clients">Clients autorisés</label>
                <div class="form-text mb-2">
                    Liste blanche des clients (adresses IP, sous-réseaux CIDR ou identifiants) autorisés à
                    utiliser OnyxFilter. Si cette liste n'est pas vide, seuls ces clients seront servis.
                </div>
                <textarea id="allowed-clients"
                          class="form-control font-monospace"
                          rows="4"
                          placeholder="Saisissez un client par ligne"
                          @bind="AllowedClientsText"
                          @bind:event="oninput"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label" for="disallowed-clients">Clients interdits</label>
                <div class="form-text mb-2">Liste noire des clients. Elle est ignorée si la liste des clients autorisés n'est pas vide.</div>
                <textarea id="disallowed-clients"
                          class="form-control font-monospace"
                          rows="4"
                          placeholder="Saisissez un client par ligne"
                          @bind="DisallowedClientsText"
                          @bind:event="oninput"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label" for="disallowed-domains">Domaines interdits</label>
                <div class="form-text mb-2">
                    Ces requêtes ne sont pas traitées du tout et sont exclues des statistiques et du journal des
                    requêtes.
                </div>
                <textarea id="disallowed-domains"
                          class="form-control font-monospace"
                          rows="4"
                          placeholder="Saisissez un domaine par ligne"
                          @bind="DisallowedDomainsText"
                          @bind:event="oninput"></textarea>
            </div>            
        </div>
        <div class="card-footer">
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-success" @onclick="SaveAccessSettingsAsync">Enregistrer</button>
            </div>
            @if (!string.IsNullOrEmpty(AccessStatusMessage))
            {
                <div class="alert @(AccessStatusMessage.StartsWith("Erreur", StringComparison.Ordinal) ? "alert-danger" : "alert-success") py-2 mt-3 mb-0">@AccessStatusMessage</div>
            }
        </div>
    </div>
</div>
