# Service systemd d'OnyxFilter (installé par deploy/install.sh dans /etc/systemd/system/).
[Unit]
Description=OnyxFilter - résolveur DNS filtrant
Documentation=https://github.com/AnthoDingo/OnyxFilter
After=network-online.target
Wants=network-online.target

[Service]
# L'application signale à systemd qu'elle est prête (Microsoft.Extensions.Hosting.Systemd).
Type=notify
User=onyxfilter
Group=onyxfilter
WorkingDirectory=/opt/onyxfilter
ExecStart=/opt/onyxfilter/OnyxFilter --server
Environment=ASPNETCORE_URLS=http://0.0.0.0:8080
Environment=DOTNET_NOLOGO=1

# Écoute sur les ports privilégiés (53 pour le DNS, 443/853 pour le DNS chiffré) sans être root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

# Après l'installation d'une mise à jour depuis l'interface ou l'API, OnyxFilter s'arrête de lui-même :
# systemd le relance aussitôt sur la nouvelle version (Restart=always est donc indispensable).
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
